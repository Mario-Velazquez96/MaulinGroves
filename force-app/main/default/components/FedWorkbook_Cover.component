<apex:component layout="none">
    <!--
      ============================================================
      FedWorkbook_Cover
      Rebranded cover page (Page 1) for the Groves Federal Workbook.
      Renders as a fixed-width "page" so it sits alongside the other
      workbook pages like sheets of paper. Safe for both interactive
      pages and renderAs="pdf".
      ============================================================
    -->

    <style type="text/css">
        /* PDF-safe: no flexbox, no vh units, no CSS variables */
        .gfg-cover {
            background-color: #3A5754;
            margin: 0 auto 24px;
            width: 850px;
            max-width: 100%;
            box-sizing: border-box;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
            page-break-after: always;
        }
        .gfg-cover__img {
            display: block;
            width: 100%;
            height: auto;
        }
    </style>

    <div class="gfg-cover">
        <apex:image url="{!$Resource.Pg1GrovesFedForm}"
            styleClass="gfg-cover__img"
            alt="Groves Financial Group - Federal Employee Benefits and Retirement Workbook" />
    </div>
</apex:component>
