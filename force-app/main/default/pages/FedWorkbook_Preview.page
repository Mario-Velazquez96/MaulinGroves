<apex:page showHeader="false" sidebar="false" standardStylesheets="false"
    applyHtmlTag="false" applyBodyTag="false" docType="html-5.0"
    title="Federal Workbook - Preview">
    <!--
      Preview harness for the rebranded Federal Workbook components.
      As each section component is built, add it here to review the result.
      This page is for preview only and is not wired into the live workbook.
    -->
    <html>

    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>Federal Workbook - Preview</title>
        <style type="text/css">
            html, body {
                margin: 0;
                padding: 0;
                background: #e6e8e6;
            }
            /* Backdrop around the pages so each section looks like a sheet of paper */
            .gfg-pageframe { padding: 32px; }
        </style>
    </head>

    <body>
        <div class="gfg-pageframe">
            <!-- Page 1: Cover -->
            <c:FedWorkbook_Cover />

            <!-- Page 2: Federal Employee Information -->
            <apex:include pageName="FedWorkbook_EmployeeInfo" />

            <!-- Page 3: FEGLI Basic Life (renders only when Basic or a relevant FEGLI code is set) -->
            <apex:include pageName="FedWorkbook_BasicLife" />

            <!-- Page 4: FEGLI Option A and Option C (renders when either option is active) -->
            <apex:include pageName="FedWorkbook_FegliAC" />
        </div>
    </body>

    </html>
</apex:page>
