    <script>
        (function (window, document, undefined) {
            var storagePrefix = 'GPIS_Federal_Workbook:{!JSENCODE(Lead.Id)}:';
            // console.log('StoragePrefix: '+storagePrefix);
            function getStorageKey(elementId) {
                // console.log('Key: '+storagePrefix + elementId);
                return storagePrefix + elementId;
            }
            function changeSelect(event) {
                if (!event || !event.target || !event.target.id) {
                    return;
                }
                if (event.target.type == 'checkbox' || event.target.type == 'radio') {
                    window.localStorage.setItem(getStorageKey(event.target.id), event.target.checked ? 'checked' : 'unchecked');
                } else {
                    window.localStorage.setItem(getStorageKey(event.target.id), event.target.value);
                }
            }

            function load(event) {
                var i = 0,
                    k, e, storedValue;
                while (i < window.localStorage.length) {
                    k = window.localStorage.key(i++);
                    if (k && k.indexOf(storagePrefix) === 0) {
                        e = document.getElementById(k.substring(storagePrefix.length));
                        // console.log('Key element: ', e);
                        if (e) {
                            storedValue = window.localStorage.getItem(k);
                            if (e.type == 'checkbox' || e.type == 'radio') {
                                e.checked = storedValue == 'checked';
                            } else if (storedValue !== null) {
                                e.value = storedValue;
                            }
                        }
                        // console.log('Key element value: ', storedValue);
                    }
                }
            }

            function clearData(event) {
                var i = 0;
                var keysToRemove = [];
                while (i < window.localStorage.length) {
                    var key = window.localStorage.key(i++);
                    if (key && key.indexOf(storagePrefix) === 0) {
                        keysToRemove.push(key);
                    }
                }
                for (var j = 0; j < keysToRemove.length; j++) {
                    // console.log('Key to remove: '+keysToRemove[j]);
                    window.localStorage.removeItem(keysToRemove[j]);
                }
            }
            window.addEventListener('load', load, true);
            window.addEventListener('change', changeSelect, true);
            window.addEventListener('select', changeSelect, true);
            window.addEventListener('submit', clearData, true);
        })(window, document)
    </script>

