<apex:page standardController="Lead" extensions="FedWorkbook_EmployeeInfoExt"
    showHeader="false" sidebar="false"
    standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false"
    docType="html-5.0" title="Federal Employee Information">
    <!--
      ============================================================
      FedWorkbook_EmployeeInfo  (Page 2)
      Rebranded "Federal Benefits & Retirement Analysis" employee form.
      Uses the Lead standard controller (quicksave) so all fields,
      including the new Apt__c fields, bind without modifying existing Apex.
      Designed to render standalone or via apex:include.
      ============================================================
    -->

    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=PT+Serif:wght@400;700&amp;display=swap');

        .gfg2-doc {
            position: relative;
            background: #ffffff;
            color: #2b2b2b;
            font-family: 'PT Serif', Georgia, 'Times New Roman', serif;
            font-size: 15px;
            line-height: 1.5;
            margin: 0 auto 24px;
            width: 850px;
            max-width: 100%;
            box-sizing: border-box;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        }
        .gfg2-sidebar {
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 54px;
            background: #3A5754;
        }
        .gfg2-pagenum {
            position: absolute;
            bottom: 18px; left: 0;
            width: 54px;
            text-align: center;
            color: #ffffff;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 30px;
            font-weight: 800;
        }
        .gfg2-main { margin-left: 54px; padding: 26px 38px 46px; }

        .gfg2-title {
            margin: 0 0 8px;
            color: #3A5754;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 33px;
            font-weight: 800;
            letter-spacing: .2px;
        }
        .gfg2-accent { height: 9px; background: #8FA68C; margin: 0 0 18px; }

        .gfg2-row { margin: 7px 0; }
        .gfg2-field {
            display: inline-flex;
            align-items: baseline;
            gap: 6px;
            margin: 5px 22px 5px 0;
        }
        .gfg2-field label { font-weight: 700; white-space: nowrap; }

        /* Editable inputs styled as fill-in underlines */
        .gfg2-input {
            border: 0;
            border-bottom: 1px solid #9aa6a3;
            background: transparent;
            font: inherit;
            color: #1f3b38;
            padding: 1px 4px;
            min-width: 130px;
        }
        .gfg2-input:focus { outline: none; border-bottom: 2px solid #3A5754; }
        select.gfg2-input { min-width: 150px; }

        /* Currency / percent symbols shown next to editable inputs */
        .gfg2-affix { display: inline-flex; align-items: baseline; gap: 2px; }
        .gfg2-sym { font-weight: 700; color: #1f3b38; }

        /* Read-only values shown as a filled blank */
        .gfg2-ro {
            display: inline-block;
            min-width: 130px;
            border-bottom: 1px solid #cdd5d3;
            padding: 1px 4px;
            color: #555;
        }
        .gfg2-check { margin: 0 4px 0 0; vertical-align: middle; }
        .gfg2-ml { margin-left: 14px; }
        .gfg2-link { color: #3A5754; font-weight: 700; text-decoration: underline; cursor: pointer; }
        /* Red "+ 5% Govt. Match" indicator next to the TSP contribution input */
        .gfg2-match { color: #B91C1C; font-weight: 700; padding-left: 6px; white-space: nowrap; }

        .gfg2-disclaimer {
            text-align: center;
            font-style: italic;
            margin: 16px 0 18px;
        }
        .gfg2-section-rule { border: 0; border-top: 2px solid #8FA68C; margin: 18px 0; }

        .gfg2-body { margin: 16px 0; text-indent: 28px; text-align: justify; }
        .gfg2-h2 {
            text-align: center;
            color: #2b2b2b;
            font-weight: 700;
            font-size: 21px;
            margin: 22px 0 10px;
        }
        .gfg2-cols {
            column-count: 2;
            column-gap: 48px;
            max-width: 760px;
            margin: 0 auto;
            padding-left: 26px;
        }
        .gfg2-cols li { margin: 6px 0; break-inside: avoid; }

        .gfg2-savebar {
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 12px;
            color: #3A5754;
            font-weight: 600;
        }
        @media (max-width: 640px) {
            .gfg2-cols { column-count: 1; }
            .gfg2-main { padding: 20px; }
        }
    </style>

    <div class="gfg2-doc">
        <div class="gfg2-sidebar"><span class="gfg2-pagenum">2</span></div>

        <div class="gfg2-main">
            <h1 class="gfg2-title">Federal Benefits &amp; Retirement Analysis</h1>
            <div class="gfg2-accent"></div>

            <apex:form id="gfg2form">
                <!-- Every editable field calls this onchange to auto-save silently -->
                <apex:actionFunction name="gfg2Save" action="{!saveLead}" reRender="gfg2msgs,gfg2spouse,gfg2tsp" />
                <!-- Retirement System (FERS / Special Groups) toggles add or remove
                     whole workbook sections and their navigation links. Those live
                     outside this included form (in FedWorkbook_Preview), so a partial
                     reRender can't refresh them. After saving the toggle we reload the
                     page so every rendered gate re-evaluates — matching the legacy
                     GPIS_Federal_Workbook behavior where save() reRenders the nav bar
                     and the Special Groups section. -->
                <apex:actionFunction name="gfg2SaveReload" action="{!saveLead}" reRender="gfg2msgs"
                    oncomplete="window.location.reload();" />
                <!-- AJAX target: silent on success; displays any save/validation error -->
                <apex:outputPanel id="gfg2msgs"><apex:pageMessages /></apex:outputPanel>
                <!-- <apex:actionStatus id="gfg2status"
                    startText=" Saving..." stopText=" Saved &#10003;"
                    styleClass="gfg2-savebar" />-->

                <!-- Specialist header -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>Date:</label>
                        <span class="gfg2-ro">
                            <apex:outputText value="{0,date,MM/dd/yyyy}">
                                <apex:param value="{!TODAY()}" />
                            </apex:outputText>
                        </span>
                    </span>
                    <span class="gfg2-field">
                        <label>Specialist Name:</label>
                        <span class="gfg2-ro">{!$User.FirstName} {!$User.LastName}</span>
                    </span>
                    <span class="gfg2-field">
                        <label>Phone:</label>
                        <span class="gfg2-ro">{!$User.Phone}</span>
                    </span>
                </div>
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>Email:</label>
                        <span class="gfg2-ro">{!$User.Email}</span>
                    </span>
                </div>

                <p class="gfg2-disclaimer">
                    Information used in this analysis is provided by the federal employee
                </p>

                <!-- Identity (read-only) -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>Name:</label>
                        <apex:outputField value="{!Lead.Name}" styleClass="gfg2-ro" />
                    </span>
                    <span class="gfg2-field">
                        <label>Email:</label>
                        <apex:outputField value="{!Lead.Email}" styleClass="gfg2-ro" />
                    </span>
                    <span class="gfg2-field">
                        <label>Phone:</label>
                        <apex:outputField value="{!Lead.MobilePhone_Formatted__c}" styleClass="gfg2-ro" />
                    </span>
                </div>

                <!-- Address (read-only) -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>Address:</label>
                        <apex:outputField value="{!Lead.Street}" styleClass="gfg2-ro" />
                    </span>
                    <span class="gfg2-field">
                        <label>City:</label>
                        <apex:outputField value="{!Lead.City}" styleClass="gfg2-ro" />
                    </span>
                    <span class="gfg2-field">
                        <label>State:</label>
                        <apex:outputField value="{!Lead.State}" styleClass="gfg2-ro" />
                    </span>
                    <span class="gfg2-field">
                        <label>Zip:</label>
                        <apex:outputField value="{!Lead.PostalCode}" styleClass="gfg2-ro" />
                    </span>
                </div>

                <!-- Employment (editable) -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>Job Title:</label>
                        <apex:inputField value="{!Lead.Title}" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                    <span class="gfg2-field">
                        <label>Agency:</label>
                        <apex:inputField value="{!Lead.Company}" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                    <span class="gfg2-field">
                        <label>Date of Hire:</label>
                        <apex:input value="{!hireDate}" type="date" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                    <span class="gfg2-field">
                        <label>Exp. Retirement Date:</label>
                        <apex:input value="{!retireDate}" type="date" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                </div>

                <!-- DOB (editable) + derived read-only fields -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>DOB:</label>
                        <apex:input value="{!birthDate}" type="date" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                    <span class="gfg2-field">
                        <label>Current Age:</label>
                        <apex:outputField value="{!Lead.Contact_Age__c}" styleClass="gfg2-ro" />
                    </span>
                    <span class="gfg2-field">
                        <label>Years of Creditable Service:</label>
                        <apex:outputField value="{!Lead.Years_of_Employment__c}" styleClass="gfg2-ro" />
                    </span>
                    <span class="gfg2-field">
                        <label>Expected Retirement Age:</label>
                        <apex:outputField value="{!Lead.Expected_Retirement_Age__c}" styleClass="gfg2-ro" />
                    </span>
                </div>

                <!-- Marital / Spouse / Federal Employee -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>Marital Status:</label>
                        <apex:inputField value="{!Lead.Marital_Status__c}" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                    <apex:outputPanel id="gfg2spouse">
                        <apex:outputPanel layout="none"
                            rendered="{!OR(Lead.Marital_Status__c == 'Married', Lead.Marital_Status__c == 'Registered Partnership')}">
                            <span class="gfg2-field">
                                <apex:outputLink value="/flow/contact_create_update_spouse?recordId={!Lead.Id}"
                                    target="_blank" styleClass="gfg2-link">Spouse Name:</apex:outputLink>
                                <apex:outputText value="{!Lead.Spouse_Name__r.Name}" styleClass="gfg2-ro" />
                            </span>
                        </apex:outputPanel>
                    </apex:outputPanel>
                    <span class="gfg2-field">
                        <label>Federal Employee:</label>
                        <apex:inputField value="{!Lead.Federal_Employee__c}" styleClass="gfg2-check" onchange="gfg2Save();" />
                    </span>
                    <span class="gfg2-field">
                        <label>Affiliation:</label>
                        <apex:inputField value="{!Lead.Affiliation__c}" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                </div>

                <!-- Base Salary + Retirement System -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>Base Salary:</label>
                        <span class="gfg2-affix">
                            <span class="gfg2-sym">$</span>
                            <apex:inputField value="{!Lead.Base_Salary__c}" styleClass="gfg2-input" onchange="gfg2Save();" />
                        </span>
                    </span>
                    <span class="gfg2-field">
                        <label>Salary Interval:</label>
                        <apex:inputField value="{!Lead.Salary_Interval__c}" styleClass="gfg2-input" onchange="gfg2Save();" />
                    </span>
                    <span class="gfg2-field" id="gfg2-retsys-group">
                        <label>Retirement System:</label>
                        <apex:inputField value="{!Lead.FERS__c}" styleClass="gfg2-check" onchange="gfg2RetSys(this); gfg2SaveReload();" /> FERS
                        <apex:inputField value="{!Lead.Special_Group_Member__c}" styleClass="gfg2-check" style="margin-left:14px" onchange="gfg2RetSys(this); gfg2SaveReload();" /> Special Groups
                    </span>
                </div>

                <!-- TSP balances + contribution mode (% or $) — replicated from the
                     legacy GPIS_Federal_Workbook page. Each balance has a % and a $
                     mode checkbox; the % box reveals a percent contribution input and
                     the $ box reveals a dollar (monthly) contribution input. The panel
                     reRenders via gfg2Save so the toggles re-evaluate on auto-save. -->
                <apex:outputPanel id="gfg2tsp" layout="block">

                    <!-- TSP Balance ($) -->
                    <div class="gfg2-row">
                        <span class="gfg2-field">
                            <label>TSP Balance ($):</label>
                            <span class="gfg2-affix">
                                <span class="gfg2-sym">$</span>
                                <apex:inputField value="{!Lead.TSP_Total__c}" styleClass="gfg2-input" style="min-width:100px" onchange="gfg2Save();" />
                            </span>
                        </span>
                        <span class="gfg2-field">
                            <apex:inputField value="{!Lead.percTSP__c}" styleClass="gfg2-check" onchange="gfg2Save();" /> %
                            <apex:inputField value="{!Lead.dollarTSP__c}" styleClass="gfg2-check gfg2-ml" onchange="gfg2Save();" /> $
                        </span>
                        <apex:outputPanel layout="none" rendered="{!Lead.percTSP__c == true}">
                            <span class="gfg2-field">
                                <label>TSP Contribution (%):</label>
                                <span class="gfg2-affix">
                                    <apex:inputField value="{!Lead.TSP_Contribution__c}" styleClass="gfg2-input" style="min-width:60px" onchange="gfg2Save();" />
                                    <span class="gfg2-sym">%</span>
                                </span>
                            </span>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!Lead.dollarTSP__c == true}">
                            <span class="gfg2-field">
                                <label>TSP Contribution ($):</label>
                                <span class="gfg2-affix">
                                    <span class="gfg2-sym">$</span>
                                    <apex:inputField value="{!Lead.Monthly_Contribution__c}" styleClass="gfg2-input" style="min-width:80px" onchange="gfg2Save();" />
                                </span>
                            </span>
                        </apex:outputPanel>
                        <apex:outputText styleClass="gfg2-match" value="+ 5% Govt. Match"
                            rendered="{!(Lead.TSP_Contribution__c != null && Lead.TSP_Contribution__c >= 0.05 && Lead.percTSP__c == true) || (Lead.ROTH_TSP_Contribution__c != null && Lead.ROTH_TSP_Contribution__c >= 0.05 && Lead.percROTH__c == true)}" />
                    </div>

                    <!-- Tax-Free (Roth) TSP Balance ($) -->
                    <div class="gfg2-row">
                        <span class="gfg2-field">
                            <label>Tax-Free TSP Balance ($):</label>
                            <span class="gfg2-affix">
                                <span class="gfg2-sym">$</span>
                                <apex:inputField value="{!Lead.ROTH_Total__c}" styleClass="gfg2-input" style="min-width:100px" onchange="gfg2Save();" />
                            </span>
                        </span>
                        <span class="gfg2-field">
                            <apex:inputField value="{!Lead.percROTH__c}" styleClass="gfg2-check" onchange="gfg2Save();" /> %
                            <apex:inputField value="{!Lead.dollarROTH__c}" styleClass="gfg2-check gfg2-ml" onchange="gfg2Save();" /> $
                        </span>
                        <apex:outputPanel layout="none" rendered="{!Lead.percROTH__c == true}">
                            <span class="gfg2-field">
                                <label>ROTH TSP Contribution (%):</label>
                                <span class="gfg2-affix">
                                    <apex:inputField value="{!Lead.ROTH_TSP_Contribution__c}" styleClass="gfg2-input" style="min-width:60px" onchange="gfg2Save();" />
                                    <span class="gfg2-sym">%</span>
                                </span>
                            </span>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!Lead.dollarROTH__c == true}">
                            <span class="gfg2-field">
                                <label>ROTH TSP Contribution ($):</label>
                                <span class="gfg2-affix">
                                    <span class="gfg2-sym">$</span>
                                    <apex:inputField value="{!Lead.Monthly_ROTH_Contribution__c}" styleClass="gfg2-input" style="min-width:80px" onchange="gfg2Save();" />
                                </span>
                            </span>
                        </apex:outputPanel>
                    </div>
                </apex:outputPanel>

                <!-- FEGLI Code -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>FEGLI Code:</label>
                        <apex:inputField value="{!Lead.FEGLI_Code_Picklist__c}" styleClass="gfg2-input" onchange="gfg2SaveReload();" />
                    </span>
                </div>

                <!-- FEGLI Plan: replicated from the legacy GPIS_Federal_Workbook page.
                     When no FEGLI code is set (== '--') the Basic / Option A / B / C
                     checkboxes are EDITABLE (bound to Lead.Basic__c / OptionA__c /
                     OptionB__c / OptionC__c). When a FEGLI code IS set, the checkboxes
                     become read-only and their checked state is DERIVED from the code's
                     letters/digits via the same CONTAINS logic the legacy page uses. -->
                <div class="gfg2-row">
                    <span class="gfg2-field">
                        <label>FEGLI Plan:</label>

                        <!-- Basic -->
                        <apex:inputField value="{!Lead.Basic__c}" styleClass="gfg2-check"
                            rendered="{!Lead.FEGLI_Code_Picklist__c == '--'}" onchange="gfg2SaveReload();" />
                        <apex:inputCheckbox value="{!Lead.Basic__c}" selected="false" styleClass="gfg2-check" disabled="true"
                            rendered="{!Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != '' && (Lead.FEGLI_Code_Picklist__c == 'Ao' || Lead.FEGLI_Code_Picklist__c == 'Bo')}" />
                        <apex:inputCheckbox value="{!Lead.Basic__c}" selected="true" styleClass="gfg2-check" disabled="true"
                            rendered="{!Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != '' && Lead.FEGLI_Code_Picklist__c != 'Ao' && Lead.FEGLI_Code_Picklist__c != 'Bo'}" /> Basic

                        <!-- Option A -->
                        <apex:inputField value="{!Lead.OptionA__c}" styleClass="gfg2-check gfg2-ml"
                            rendered="{!Lead.FEGLI_Code_Picklist__c == '--'}" onchange="gfg2SaveReload();" />
                        <apex:inputCheckbox value="{!Lead.OptionA__c}" selected="false" styleClass="gfg2-check gfg2-ml" disabled="true"
                            rendered="{!Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != '' && Lead.FEGLI_Code_Picklist__c != 'Ho' && Lead.FEGLI_Code_Picklist__c != 'Do' && Lead.FEGLI_Code_Picklist__c != 'Lo' && NOT( CONTAINS(Lead.FEGLI_Code_Picklist__c, 'R')) && NOT( CONTAINS(Lead.FEGLI_Code_Picklist__c, 'J')) && (Lead.FEGLI_Code_Picklist__c == 'Ao' || Lead.FEGLI_Code_Picklist__c == 'Bo' || Lead.FEGLI_Code_Picklist__c == 'Co' || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'E') || NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'F')) || Lead.FEGLI_Code_Picklist__c == 'Go' || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'I') || Lead.FEGLI_Code_Picklist__c == 'Ko' || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'M') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Q') || Lead.FEGLI_Code_Picklist__c == 'So' || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'U') || Lead.FEGLI_Code_Picklist__c == 'Wo' || Lead.FEGLI_Code_Picklist__c == 'Xo' || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Y'))}" />
                        <apex:inputCheckbox value="{!Lead.OptionA__c}" selected="true" styleClass="gfg2-check gfg2-ml" disabled="true"
                            rendered="{!(Lead.FEGLI_Code_Picklist__c != '' && Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != 'Ao' && Lead.FEGLI_Code_Picklist__c != 'Bo' && Lead.FEGLI_Code_Picklist__c != 'Co' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'E')) && Lead.FEGLI_Code_Picklist__c != 'Go' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'I')) && Lead.FEGLI_Code_Picklist__c != 'Ko' && Lead.FEGLI_Code_Picklist__c != 'Lo' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'M')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Q')) && Lead.FEGLI_Code_Picklist__c != 'So' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'U')) && Lead.FEGLI_Code_Picklist__c != 'Wo' && Lead.FEGLI_Code_Picklist__c != 'Xo' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Y'))) || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'F') || Lead.FEGLI_Code_Picklist__c == 'Ho' || Lead.FEGLI_Code_Picklist__c == 'Do' || Lead.FEGLI_Code_Picklist__c == 'Lo'}" /> Option A

                        <!-- Option B -->
                        <apex:inputField value="{!Lead.OptionB__c}" styleClass="gfg2-check gfg2-ml"
                            rendered="{!Lead.FEGLI_Code_Picklist__c == '--'}" onchange="gfg2SaveReload();" />
                        <apex:inputCheckbox value="{!Lead.OptionB__c}" selected="false" styleClass="gfg2-check gfg2-ml" disabled="true"
                            rendered="{!Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != '' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'G')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'H')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'I')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'J')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'K')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'L')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'M')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'N')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'P')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Q')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'R')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'S')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'T')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'U')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'V')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'W')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'X')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Y')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Z'))}" />
                        <apex:inputCheckbox value="{!Lead.OptionB__c}" selected="true" styleClass="gfg2-check gfg2-ml" disabled="true"
