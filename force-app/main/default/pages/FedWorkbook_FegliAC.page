<apex:page id="formAC4" standardController="Lead" extensions="FedWorkbook_FegliACExt"
    showHeader="false" sidebar="false" standardStylesheets="false"
    applyHtmlTag="false" applyBodyTag="false"
    docType="html-5.0" title="FEGLI - Option A and Option C"
    rendered="{!Lead.OptionA__c == true || Lead.OptionC__c == true || CONTAINS(Lead.FEGLI_Plan__c, 'Option A') || CONTAINS(Lead.FEGLI_Plan__c, 'Option C')}">
    <!--
      ============================================================
      FedWorkbook_FegliAC  (Page 4)
      Rebranded FEGLI Option A + Option C section.
      Uses the FedWorkbook_FegliACExt extension to compute the
      bi-weekly rates and multiples in Apex, so the page can bind
      to simple properties:
        optionACost, optionCMultiples, optionCBiWeeklyFactor
      Underlying Lead fields are the same as the original FEGLIAC.page.
      ============================================================
    -->

    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=PT+Serif:wght@400;700&amp;display=swap');

        .gfg4-doc {
            position: relative;
            background: #ffffff;
            color: #2b2b2b;
            font-family: 'PT Serif', Georgia, 'Times New Roman', serif;
            font-size: 14px;
            line-height: 1.55;
            margin: 0 auto 24px;
            width: 850px;
            max-width: 100%;
            box-sizing: border-box;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        }
        .gfg4-sidebar { position: absolute; left: 0; top: 0; bottom: 0; width: 54px; background: #3A5754; }
        .gfg4-pagenum {
            position: absolute; bottom: 18px; left: 0; width: 54px;
            text-align: center; color: #ffffff;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 30px; font-weight: 800;
        }
        .gfg4-main { margin-left: 54px; padding: 0 36px 30px; }

        .gfg4-header {
            background: #8FA68C;
            padding: 14px 24px;
            margin: 0 -36px 18px -36px;
        }
        .gfg4-title {
            margin: 0; color: #3A5754;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 26px; font-weight: 800; line-height: 1.1;
        }

        .gfg4-body { margin: 8px 0; text-align: justify; }
        .gfg4-cost { color: #B91C1C; font-weight: 700; }
        .gfg4-amount { font-weight: 700; text-decoration: underline; }

        .gfg4-cols { display: flex; gap: 22px; align-items: flex-start; flex-wrap: wrap; margin: 16px 0; }
        .gfg4-cols__left, .gfg4-cols__right { flex: 1 1 320px; }

        .gfg4-table { border-collapse: separate; border-spacing: 1px; margin: 0 auto; }
        .gfg4-table th, .gfg4-table td {
            padding: 5px 14px; font-size: 13px; text-align: center; border: none;
        }
        .gfg4-table th { background: #B91C1C; color: #ffffff; font-weight: 700; }
        .gfg4-table td { background: #4B5563; color: #ffffff; }

        .gfg4-sub {
            text-align: center; color: #2b2b2b; font-weight: 700;
            font-size: 15px; margin: 6px 0; text-decoration: underline;
        }
        .gfg4-italic { text-align: center; font-style: italic; font-size: 13px; margin: 0 0 14px; }
        .gfg4-arrow-img {
            display: block;
            max-width: 100%;
            height: auto;
            margin: 6px auto 12px;
        }

        .gfg4-blank {
            display: inline-block; min-width: 120px;
            border-bottom: 1px solid #9aa6a3;
            text-align: right; padding: 0 6px;
            color: #1f3b38; font-weight: 700;
        }
        .gfg4-row { margin: 10px 0; display: flex; align-items: baseline; gap: 10px; }
        .gfg4-row > .gfg4-label { flex: 0 0 auto; }
        .gfg4-row > .gfg4-blank { flex: 1 1 auto; }

        @media (max-width: 700px) {
            .gfg4-cols { flex-direction: column; }
        }
    </style>

    <div class="gfg4-doc">
        <div class="gfg4-sidebar"><span class="gfg4-pagenum">4</span></div>

        <div class="gfg4-main">

            <!-- ===== OPTION A ===== -->
            <apex:outputPanel layout="block"
                rendered="{!Lead.OptionA__c == true || CONTAINS(Lead.FEGLI_Plan__c, 'Option A')}">

                <div class="gfg4-header">
                    <h1 class="gfg4-title">FEGLI- Option A</h1>
                </div>

                <p class="gfg4-body">
                    Optional Life Insurance - Federal employees who are covered under
                    Basic life insurance program may also elect to purchase one or all
                    three of the Optional coverage plans.
                </p>
                <p class="gfg4-body">
                    <b>Option A</b> - Standard Optional Insurance -
                    <span class="gfg4-cost">The employee pays the full cost</span>
                    for this optional insurance which offers an additional $10,000 of
                    FEGLI. Option A also offers an equal amount of AD&amp;D protection.
                    Costs are age-based.
                </p>

                <div class="gfg4-cols">
                    <div class="gfg4-cols__left">
                        <table class="gfg4-table">
                            <thead>
                                <tr>
                                    <th>Employee Age Band</th>
                                    <th>Pay Mode factor<br/>Bi-Weekly</th>
                                    <th>Pay Mode Factor<br/>Monthly</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Under 35</td><td>$0.20</td><td>$0.43</td></tr>
                                <tr><td>35-39</td><td>$0.20</td><td>$0.43</td></tr>
                                <tr><td>40-44</td><td>$0.30</td><td>$0.65</td></tr>
                                <tr><td>45-49</td><td>$0.60</td><td>$1.30</td></tr>
                                <tr><td>50-54</td><td>$1.00</td><td>$2.17</td></tr>
                                <tr><td>55-59</td><td>$1.80</td><td>$3.90</td></tr>
                                <tr><td>60 Plus</td><td>$6.00</td><td>$13.00</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="gfg4-cols__right">
                        <h2 class="gfg4-sub">Option A - After Retirement</h2>
                        <p class="gfg4-italic">
                            The amount of your Option A life insurance decreases at age 65
                            or at retirement, whichever is later, at a rate of 2% per
                            month until a 75% reduction is reached.
                        </p>
                        <apex:image url="{!$Resource.Pg5GrovesArrow}"
                            styleClass="gfg4-arrow-img"
                            alt="Option A coverage decreases from $10,000 to $2,500" />
                        <p style="text-align:center;margin-top:18px">
                            Option A Cost: <span class="gfg4-cost">$</span>
                            <span class="gfg4-blank" style="min-width:90px">
                                <apex:outputText value="{0, number, 0.00}">
                                    <apex:param value="{!optionACost}" />
                                </apex:outputText>
                            </span>
                        </p>
                    </div>
                </div>
            </apex:outputPanel>

            <!-- ===== OPTION C ===== -->
            <apex:outputPanel layout="block"
                rendered="{!Lead.OptionC__c == true || CONTAINS(Lead.FEGLI_Plan__c, 'Option C')}">

                <div class="gfg4-header">
                    <h1 class="gfg4-title">FEGLI- Option C</h1>
                </div>

                <p class="gfg4-body">
                    Option C - Family Optional Insurance -
                    <span class="gfg4-cost">The employee pays the full cost</span>
                    for optional family coverage. This coverage insures the lives of your
                    spouse and eligible dependent children. You have the option of one to
                    five multiples.
                    <span class="gfg4-cost">Each multiple is equal to $5,000 for your
                    spouse and $2,500 for each eligible dependent child.</span>
                </p>
                <p class="gfg4-body">
                    "Eligible family members" means your present spouse, and your
                    unmarried dependent child, including an adopted child, a stepchild or
                    a recognized natural child who is living with you, or who is
                    receiving regular and substantial support from you. To be covered, a
                    child must be under 22 years of age, or be 22 or over and incapable
                    of self-support because of mental or physical disability, which
                    existed before the child became 22 years of age.
                </p>

                <div class="gfg4-cols">
                    <div class="gfg4-cols__left">
                        <div class="gfg4-row">
                            <span class="gfg4-label">Number of Multiples:</span>
                            <span class="gfg4-blank">
                                <apex:outputText value="{0, number, #0}">
                                    <apex:param value="{!optionCMultiples}" />
                                </apex:outputText>
                            </span>
                        </div>
                        <div class="gfg4-row">
                            <span class="gfg4-label">Spouse Benefit:</span>
                            <span class="gfg4-blank">
                                <apex:outputText value="{0, number, $#,##0.00}">
                                    <apex:param value="{!optionCMultiples * 5000}" />
                                </apex:outputText>
                            </span>
                        </div>
                        <div class="gfg4-row">
                            <span class="gfg4-label">Each Child Benefit:</span>
                            <span class="gfg4-blank">
                                <apex:outputText value="{0, number, $#,##0.00}">
                                    <apex:param value="{!optionCMultiples * 2500}" />
                                </apex:outputText>
                            </span>
                        </div>
                        <div class="gfg4-row">
                            <span class="gfg4-label">
                                Multiples
                                <span class="gfg4-amount" style="min-width:30px;display:inline-block;text-align:center">
                                    <apex:outputText value="{0, number, #0}">
                                        <apex:param value="{!optionCMultiples}" />
                                    </apex:outputText>
                                </span>
                                X Factor
                                <span class="gfg4-amount" style="min-width:50px;display:inline-block;text-align:center">
                                    <apex:outputText value="{0, number, #0.00}">
                                        <apex:param value="{!optionCBiWeeklyFactor}" />
                                    </apex:outputText>
                                </span>
                                =
                            </span>
                            <span class="gfg4-blank">
                                <apex:outputText value="{0, number, $#,##0.00}">
                                    <apex:param value="{!optionCMultiples * optionCBiWeeklyFactor}" />
                                </apex:outputText>
                            </span>
                        </div>
                    </div>

                    <div class="gfg4-cols__right">
                        <table class="gfg4-table">
                            <thead>
                                <tr>
                                    <th>Age Band</th>
                                    <th>Bi-Weekly Factor</th>
                                    <th>Monthly Factor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Under 35</td><td>$0.20</td><td>$0.43</td></tr>
                                <tr><td>35-39</td><td>$0.24</td><td>$0.52</td></tr>
                                <tr><td>40-44</td><td>$0.37</td><td>$0.80</td></tr>
                                <tr><td>45-49</td><td>$0.53</td><td>$1.15</td></tr>
                                <tr><td>50-54</td><td>$0.83</td><td>$1.80</td></tr>
                                <tr><td>55-59</td><td>$1.33</td><td>$2.88</td></tr>
                                <tr><td>60-64</td><td>$2.43</td><td>$5.27</td></tr>
                                <tr><td>65-69</td><td>$2.83</td><td>$6.13</td></tr>
                                <tr><td>70-74</td><td>$3.83</td><td>$8.30</td></tr>
                                <tr><td>75-79</td><td>$5.76</td><td>$12.48</td></tr>
                                <tr><td>80- Plus</td><td>$7.80</td><td>$16.90</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <p class="gfg4-body" style="margin-top:18px">
                    <b>Continuation Of Option B and C After Retirement</b>
                </p>
                <p class="gfg4-body">
                    Your full reduction Option B and C multiples are free after you reach
                    age 65 or retire (whichever is later), but reductions begin. The full
                    reduction multiples will reduce by 2% of the pre-retirement amount per
                    month for 50 months, at which time your coverage ends. Effective April
                    24, 1999, Option B and C may be continued after retirement at per
                    $1,000 rates. You do have the option to continue paying the monthly
                    premiums and maintain coverage.
                </p>
            </apex:outputPanel>

        </div>
    </div>
</apex:page>
