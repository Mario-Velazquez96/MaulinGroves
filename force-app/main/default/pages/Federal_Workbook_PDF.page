<apex:page id="Federal_Workbook_PDF" showHeader="false" standardController="Lead" extensions="Federal_LeadControllerExtension" tabStyle="Lead" showQuickActionVfHeader="false"
    applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" renderAs="pdf">
    <apex:stylesheet value="{!$Resource.workbookStyles}" />
    <apex:stylesheet value="{!$Resource.modal}" />

    <html>

    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>GPIS Federal Benefits and Retirement Analysis</title>
        <meta name="author" content="L. Colley" />
        <meta name="description" content="This workbook is designed to help you start building your retirement income plan." />

    </head>
    <center>
        <apex:image url="{!$Resource.Pg1FedBookNewLogo}" width="100%" />
        <p style="text-indent: 0pt;text-align: left;"></p>
    </center>

    <div style="page-break-after: always" />

    <!-- PAGE 2 BEGIN -->

    <apex:image url="{!$Resource.Pg2FedbookTop}" width="100%" />
    <p style="padding-top: 2pt;text-indent: 0pt;text-align: left;">
        <br/>
    </p>
    <table style="width: 90%" align="center" cellspacing="0">
        <tbody>
            <tr style="height:16pt">
                <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="3">
                    <p class="s15" style="padding-left: 10pt;text-align: left;">Date:
                        <span style="padding-left: 5 pt;">
                            <apex:outputText value="{0, date, MM/dd/YYYY}">
                                <apex:param value="{!Today()}" />
                            </apex:outputText>
                        </span>
                    </p>
                </td>
                <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="5">
                    <p class="s15" style="padding-left: 5 pt;text-align: center;">
                        Specialist Name:
                        <span style="padding-left: 5 pt;">
                            <apex:outputText value="{!$User.FirstName + ' ' + $User.LastName}" />
                        </span>
                    </p>
                </td>
                <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="2">
                    <p class="s15" style="padding-left: 5 pt;text-align: left;">Phone:
                        <span style="padding-left: 5 pt;">
                            <apex:outputText value="{!$User.MobilePhone}" />
                        </span>
                    </p>
                </td>
            </tr>
            <tr style="height:16pt">
                <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="4">
                    <p class="s15" style="padding-top: 4pt;text-align: right;">Email:
                    </p>
                </td>
                <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="5">
                    <p class="s15" style="padding-top: 4pt;text-align: left;padding-left: 5pt;">
                        <u>
                            <a href="{!$User.Email}" style="color: blue;font-size: 10pt;">
                                <apex:outputText value="{!$User.Email}" />
                            </a>
                        </u>
                    </p>
                </td>
                <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="1">
                    <p class="s15" style="padding-left: 15 pt;text-align: left;">
                    </p>
                </td>
            </tr>
            <tr style="height:16pt">
                <td style="border-bottom-style:solid;border-bottom-width:0pt" colspan="10">
                    <p class="s20" style="padding-top: 4pt;text-align: center;font-family: sans-serif;font-size: 9pt;color: red;">Information used in this analysis is provided by the federal employee.
                    </p>
                </td>
            </tr>
        </tbody>
    </table>
    <p style="padding-top: 0pt;text-indent: 0pt;text-align: left;"></p>
    <apex:form >
        <apex:pageBlock id="page2">

            <table style="width: 99%" align="center" cellspacing="0">
