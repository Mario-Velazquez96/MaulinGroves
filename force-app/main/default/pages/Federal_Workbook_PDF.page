                                <b>
                                    <span style="background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                        <apex:outputText value="{0, date, MM/dd/YYYY}">
                                            <apex:param value="{!Lead.Expected_Retirement_Date__c}" />
                                        </apex:outputText>
                                    </span>
                                </b>
                            </p>
                        </td>
                    </tr>
                    <tr style="height:16pt">
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="3">
                            <p class="s15" style="padding-left:5pt;padding-top:4pt;text-align:center;">
                                Years of Credible Service:
                                <span style="padding-left:5pt;">
                                    <apex:outputText value="{!Lead.Years_of_Employment__c}" />
                                </span>
                            </p>
                        </td>
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="3">
                            <p class="s15" style="padding-left:5pt;padding-top:4pt;text-align:center;">
                                Exp. Retirement Age:
                                <span style="padding-left:5pt;">
                                    <apex:outputText value="{!Lead.Expected_Retirement_Age__c}" />
                                </span>
                            </p>
                        </td>
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="2">
                            <p class="s15" style="padding-left:5pt;padding-top:4pt;text-align:left;">
                                Federal Employee:
