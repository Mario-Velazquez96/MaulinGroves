                                    <apex:outputField value="{!Lead.TSP_Total__c}" style="background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                        <!-- SM NEW STARTS Bajrang -->
                                        <!--   <apex:actionSupport action="{!save}" event="onchange" reRender="page2,financial" />  -->

                                        <apex:actionSupport action="{!save}" event="onchange" reRender="page2,financial,OBEF" />
                                        <!-- SM NEW END Bajrang -->
                                    </apex:outputField></span>
                                </b>
                            </span>
                        </p>
                    </td>
                    <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="7">
                        <p class="s15" style="padding-top: 2pt;font-size: 9pt;">
                            <apex:outputField value="{!Lead.percTSP__c}" style="background-color: #00daff0f;border: none;border: 1px solid #ccc;">
                                <apex:actionSupport action="{!save}" event="onchange" reRender="page2" />
                            </apex:outputField>%
                            <apex:outputField value="{!Lead.dollarTSP__c}" style="background-color: #00daff0f;border: none;border: 1px solid #ccc;">
                                <apex:actionSupport action="{!save}" event="onchange" reRender="page2" />
                            </apex:outputField>$
                            <span class="s15" style="padding-left:5pt;font-size: 9pt;">
                                <apex:outputText value="TSP Contribution (%):" rendered="{!IF(Lead.percTSP__c == true, true, false)}" />
                            </span>
                            <span style="padding-left:8pt;font-size: 9pt;">
                                <b>    <span style="background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                    <apex:outputField value="{!Lead.TSP_Contribution__c}" style="padding-left:5pt;font-size: 11pt;background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;"
