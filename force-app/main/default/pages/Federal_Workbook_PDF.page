                            <p class="s15" style="padding-left:5pt;padding-top:1pt;text-align:left;">


                                <span style="padding-left:3pt;background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                    <apex:image url="/img/samples/flag_green.gif" rendered="{!Lead.Federal_Employee__c == 'Yes'}" />
                                </span>
                                <b>
                                    <apex:outputText value="{!Lead.Federal_Employee__c}" />
                                </b>
                            </p>
                        </td>
                    </tr>
                    <tr style="height:16pt">
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="4">
                            <p class="s15" style="padding-top:4pt;text-align:center;">
                                Marital Status:
                                <span style="padding-left:15pt;padding-right:10pt;">
                                    <b>
                                        <span style="background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                            <apex:outputText value="{!Lead.Marital_Status__c}" />
                                        </span>
                                    </b>
                                </span>
                            </p>
                        </td>
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="5">
                            <p class="s15" style="padding-left:5pt;padding-top:4pt;text-align:left;">
                                <span style="">
                                    <apex:outputText value="Spouse Name:" rendered="{!IF( Lead.Marital_Status__c == 'Married' || Lead.Marital_Status__c == 'Registered Partnership', true, false)}"
                                    />
                                    <span style="padding-left:5pt;background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                        <apex:outputText value="{!Lead.Spouse_Name__r.Name}" rendered="{!IF( Lead.Marital_Status__c == 'Married' || Lead.Marital_Status__c == 'Registered Partnership', true, false)}"
                                        />
                                    </span>
                                </span>
                            </p>
