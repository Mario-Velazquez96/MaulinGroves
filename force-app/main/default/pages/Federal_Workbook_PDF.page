                                <apex:outputText value="+ 5% Govt. Match" rendered="{!(Lead.TSP_Contribution__c != null && Lead.TSP_Contribution__c >= 0.05 && Lead.percTSP__c == true) || (Lead.ROTH_TSP_Contribution__c != null && Lead.ROTH_TSP_Contribution__c >= 0.05 && Lead.percROTH__c == true)}"
                                />
                            </span>
                            <br/>
                            <span class="s15" style="padding-left:5pt;font-size: 9pt;">
                                <apex:outputText value="TSP Contribution ($):" rendered="{!IF(Lead.dollarTSP__c == true, true, false)}" />
                            </span>
                            <span class="s15" style="padding-left:5pt;font-size: 9pt;background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                <apex:outputField value="{!Lead.Monthly_Contribution__c}" style="height:17px;width: 70px;background-color: #00daff0f;border: none;border: 1px solid #ccc;"
