                            <p class="s15" style="padding-left:5pt;padding-top:4pt;text-align:left;">
                                <!-- <b>
                                <apex:outputText value="{0, date, MM/dd/YYYY}">
                                    <apex:param value="{!Lead.Date_of_Hire__c}"/>
                                </apex:outputText>
                                
                            </b> -->
                                <b>
                                    <span style="background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                        <apex:outputText value="{0, date, MM/dd/YYYY}">
                                            <apex:param value="{!Lead.Date_of_Hire__c}" />
                                        </apex:outputText>
                                    </span>
                                </b>
                            </p>
                        </td>
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="1">
                            <p class="s15" style="padding-left:5pt;padding-top:4pt;text-align:center;">
                                Job Title:
                            </p>
                        </td>
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="2">
                            <p class="s15" style="padding-left:5pt;padding-top:4pt;text-align:left;">
                                <b>
                                    <span style="background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                        <apex:outputText value="{!Lead.Title}" />
                                    </span>
                                </b>
                            </p>
                        </td>
                        <td style="border-bottom-style:solid;border-bottom-width:1pt" colspan="4">
