                                        <apex:outputField value="{!Lead.ROTH_Total__c}" style="height:17px;width: 90px;background-color: #00daff0f;border: none;border: 1px solid #ccc;">

                                            <apex:actionSupport action="{!save}" event="onchange" reRender="page2,financial,OBEF" />
                                          
                                        </apex:outputField>
