                                Base Salary ($):
                             
                                    <b>
                                        <span style="background-color: #e0f7fa; color: #000;border: 1px solid #ccc; display: inline-block;">
                                            <apex:outputText value="{0, number, $###,###,##0.00}">
                                                <apex:param value="{!Lead.Base_Salary__c}" />
                                            </apex:outputText>
                                        </span>
                                    </b>
                           
                                <span style="padding-left:10pt;">
                                    Salary Interval:
