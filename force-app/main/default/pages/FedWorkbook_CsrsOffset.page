<apex:page id="csrs6" standardController="Lead" extensions="FedWorkbook_CsrsOffsetExt"
    showHeader="false" sidebar="false" standardStylesheets="false"
    applyHtmlTag="false" applyBodyTag="false"
    docType="html-5.0" title="CSRS Offset"
    rendered="{!Lead.CSRS_Offset__c == true}">
    <!--
      ============================================================
      FedWorkbook_CsrsOffset  (Page 6)
      CSRS Offset retirement system section.
      Uses FedWorkbook_CsrsOffsetExt to compute the offset formula
      from Lead fields:
        Years_of_CSRS_Offset__c, Predicted_Social_Security__c,
        CSRS_Annuity_Retirement__c
      Renders only when Lead.CSRS_Offset__c is true.
      ============================================================
    -->

    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=PT+Serif:wght@400;700&amp;display=swap');

        .gfg6-doc {
            position: relative;
            background: #ffffff;
            color: #2b2b2b;
            font-family: 'PT Serif', Georgia, 'Times New Roman', serif;
            font-size: 14px;
            line-height: 1.55;
            margin: 0 auto 24px;
            width: 850px;
            max-width: 100%;
            box-sizing: border-box;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        }
        /* Left sidebar */
        .gfg6-sidebar { position: absolute; left: 0; top: 0; bottom: 0; width: 54px; background: #3A5754; }
        .gfg6-pagenum {
            position: absolute; bottom: 18px; left: 0; width: 54px;
            text-align: center; color: #ffffff;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 30px; font-weight: 800;
        }
        .gfg6-main { margin-left: 54px; padding: 26px 38px 36px; }

        .gfg6-title {
            margin: 0 0 8px;
            color: #3A5754;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 33px;
            font-weight: 800;
            letter-spacing: .2px;
        }
        .gfg6-accent { height: 9px; background: #8FA68C; margin: 0 0 18px; }

        .gfg6-body { margin: 10px 0; text-align: justify; }
        .gfg6-red-bullets { list-style: disc; padding-left: 36px; margin: 8px 0; color: #B91C1C; }
        .gfg6-red-bullets li { margin: 4px 0; font-weight: 600; }

        /* Highlighted example callout */
        .gfg6-example {
            background: #faf6ec;
            padding: 18px 22px 14px;
            margin: 18px 0 22px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        .gfg6-example .gfg6-example__title { text-align: center; margin: 0 0 12px; font-size: 15px; }
        .gfg6-example p { margin: 6px 0; text-align: justify; }
        .gfg6-example ol { padding-left: 28px; margin: 4px 0 12px; }
        .gfg6-example ol li { margin: 4px 0; }

        /* Formula section */
        .gfg6-formula-head {
            text-align: center;
            color: #B91C1C;
            font-style: italic;
            font-size: 18px;
            margin: 16px 0 0;
        }
        .gfg6-formula-sub {
            text-align: center;
            color: #B91C1C;
            font-weight: 700;
            font-size: 17px;
            letter-spacing: .5px;
            margin: 0 0 14px;
        }
        .gfg6-formula { padding: 0 24px; }
        .gfg6-formula__row {
            display: flex; align-items: baseline; gap: 8px;
            margin: 10px 0; flex-wrap: wrap;
        }
        .gfg6-formula__label { flex: 0 0 auto; }
        .gfg6-formula__op { flex: 0 0 auto; }
        .gfg6-formula__blank {
            flex: 1 1 80px;
            border-bottom: 1px solid #2b2b2b;
            text-align: center;
            padding: 0 6px;
            font-weight: 700;
            color: #1f3b38;
            min-width: 80px;
        }
        .gfg6-formula__blank--wide { flex: 1 1 140px; }
        .gfg6-sublabel {
            display: flex; gap: 8px;
            margin: -4px 0 12px 0;
            padding-left: 24px;
            font-size: 12px;
            color: #2b2b2b;
            font-style: italic;
        }
        .gfg6-sublabel > span { flex: 1 1 auto; text-align: center; }
    </style>

    <div class="gfg6-doc">
        <div class="gfg6-sidebar"><span class="gfg6-pagenum">6</span></div>

        <div class="gfg6-main">

            <h1 class="gfg6-title">CSRS Offset</h1>
            <div class="gfg6-accent"></div>

            <p class="gfg6-body">
                CSRS Offset is the Civil Service Retirement System with Social Security
                Offset. It is the same as CSRS, except that the employee also contributes
                to Social Security.
            </p>
            <p class="gfg6-body">
                The CSRS Offset retirement coverage applies to employees who were
                originally covered under the Civil Service Retirement System (CSRS), had
                a break in federal service, and were rehired after 1983. Employees who
                had at least five years of creditable civilian service under CSRS before
                January 1, 1987, were generally eligible to return to CSRS upon rehire.
                However, if the employee had a break in federal service of more than one
                year, they were placed under CSRS Offset coverage, meaning they
                contributed to both CSRS and Social Security.
            </p>

            <ul class="gfg6-red-bullets">
                <li>You earn retirement credit under CSRS</li>
                <li>You earn retirement credit under Social Security</li>
            </ul>

            <p class="gfg6-body">
                When you retire, your retirement annuity is calculated the same way as a
                CSRS employee. However, when you become eligible to receive Social
                Security, your CSRS annuity is reduced (Offset) by the value of your
                Social Security benefit earned while working for the Government.
            </p>

            <ul class="gfg6-red-bullets">
                <li>The Offset begins at age 62 regardless of whether you are drawing Social Security benefits or not</li>
                <li>You may contribute to Thrift Savings Plan without matching funds</li>
            </ul>

            <!-- Example callout -->
            <div class="gfg6-example">
                <p class="gfg6-example__title">CSRS offset employee example:</p>
                <p>We will be using Jane, an employee that has an average high-3 of $65,000 and has worked 38 years.</p>
                <ol>
                    <li>Use the normal CSRS chart at 38 years, she will receive 72.25% of average high-3, which we will be using $46,962.50.</li>
                    <li>Second, we will see what her Social Security shows she will receive at 62, which we will be using $15,500.</li>
                    <li>We use the formula, years of offset service divided by 40 quarters. In this example, she has been in the offset program 30 years so the formula would be 30/40 = 75%.</li>
                    <li>$15,500 times the 75% offset = $11,625</li>
                </ol>
                <p>
                    We can now work her pension below using the numbers we have gathered.
                    This is the formula for her offset: $46,962.50 minus Jane's offset of
                    $11,625 equals $35,337. She then adds full Social Security at age 62,
                    which in this case is $15,500. This brings her total annuity to
                    $50,837.50.
                </p>
            </div>

            <!-- Formula calculation block -->
            <p class="gfg6-formula-head">The Formula to Calculate</p>
            <p class="gfg6-formula-sub">CSRS OFFSET RETIREMENT ANNUITY</p>

            <div class="gfg6-formula">
                <!-- Row 1: Years of Offset / 40 = % -->
                <div class="gfg6-formula__row">
                    <span class="gfg6-formula__label">Years of Offset:</span>
                    <span class="gfg6-formula__blank">
                        <apex:outputText value="{0, number, #0.##}">
                            <apex:param value="{!yearsOfOffset}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">&#247; 40 =</span>
                    <span class="gfg6-formula__blank">
                        <apex:outputText value="{0, number, #0.00}">
                            <apex:param value="{!offsetPercentage}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">%</span>
                </div>

                <!-- Row 2: Annual S.S. @ 62 x % = Offset -->
                <div class="gfg6-formula__row">
                    <span class="gfg6-formula__label">Annual S.S. @ Age 62:</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!annualSocialSecurity}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">X</span>
                    <span class="gfg6-formula__blank">
                        <apex:outputText value="{0, number, #0.00}">
                            <apex:param value="{!offsetPercentage}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">% =</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!offsetAmount}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">Offset</span>
                </div>

                <!-- Row 3: CSRS Annuity - Offset = Adjusted -->
                <div class="gfg6-formula__row">
                    <span class="gfg6-formula__label">CSRS Annual Retirement Annuity:</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!csrsAnnuity}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">Minus Offset</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!offsetAmount}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">=</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!adjustedCsrsAnnuity}" />
                        </apex:outputText>
                    </span>
                </div>

                <!-- Row 4: + S.S. = Total Annual / 12 = Monthly -->
                <div class="gfg6-formula__row" style="margin-top:18px">
                    <span class="gfg6-formula__label">Plus Annual S.S</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!annualSocialSecurity}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">=</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!totalAnnualAnnuity}" />
                        </apex:outputText>
                    </span>
                    <span class="gfg6-formula__op">&#247; 12 =</span>
                    <span class="gfg6-formula__blank gfg6-formula__blank--wide">
                        <apex:outputText value="{0, number, $#,##0.00}">
                            <apex:param value="{!monthlyAnnuity}" />
                        </apex:outputText>
                    </span>
                </div>
                <div class="gfg6-sublabel">
                    <span>&#160;</span>
                    <span>&#160;</span>
                    <span>&#160;</span>
                    <span>Offset Annual Annuity</span>
                    <span>&#160;</span>
                    <span>Offset Monthly Annuity</span>
                </div>
            </div>

        </div>
    </div>
</apex:page>
