                                <td class="gray" rowspan="5">None
                                    <span class="note">Note: Annuity is reduced by 5% for each year that the employee is under the age of 62.</span>
                                </td>
                            </tr>
                            <tr><td>1951</td><td>55 years, 8 mo.</td></tr>
                            <tr><td>1952</td><td>55 years, 10 mo.</td></tr>
                            <tr><td>1953 to 1964</td><td>56 years</td></tr>
                            <tr><td>1965</td><td>56 years, 2 mo.</td></tr>
                            <tr>
                                <td>1966</td><td>56 years, 4 mo.</td>
                                <td class="red" rowspan="3">&#160;</td>
                                <td class="red" rowspan="3">Any Age<br/>50</td>
                                <td class="red" rowspan="3">25<br/>20</td>
                                <td class="red" rowspan="3">You must retire under special provisions for air traffic controller, law enforcement, firefighter, or military reserve technician personnel.</td>
                            </tr>
                            <tr><td>1967</td><td>56 years, 6 mo.</td></tr>
                            <tr><td>1968</td><td>56 years, 8 mo.</td></tr>
                            <tr>
                                <td>1969</td><td>56 years, 10 mo.</td>
                                <td rowspan="2">&#160;</td>
                                <td rowspan="2">Any Age</td>
                                <td rowspan="2">25</td>
                                <td rowspan="2">OPM must have determined that your agency is undergoing a major reorganization, reduction-in-force, or transfer of function.</td>
                            </tr>
                            <tr><td>After 1969</td><td>57 Years</td></tr>
                        </tbody>
                    </table>
                    <p class="gfgp-p gfgp-italic" style="font-size:8.5pt;">*MRA = Minimum Retirement Age (between 55 and 57, based on your year of birth, per the table above).</p>

                    <!-- Top summary: the employee's current values (read-only) -->
                    <table class="gfgp-scsum">
                        <tr>
                            <td><b>Current Age:</b> <span class="v"><apex:outputText value="{0, number, #0}"><apex:param value="{!fcCurrentAge}" /></apex:outputText></span></td>
                            <td><b>Expected Retirement Age:</b> <span class="v"><apex:outputText value="{0, number, #0}"><apex:param value="{!fcExpectedRetirementAge}" /></apex:outputText></span></td>
