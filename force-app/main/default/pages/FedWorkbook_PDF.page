<apex:page id="fedWorkbookPdf" standardController="Lead" extensions="FedWorkbook_PDFExt"
    showHeader="false" sidebar="false" standardStylesheets="false"
    applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" renderAs="pdf"
    title="Groves Federal Benefits and Retirement Analysis">
    <!--
      ============================================================
      FedWorkbook_PDF  (PDF-OPTIMIZED workbook)
      Self-contained, PDF-safe layout for the Salesforce PDF engine:
        * one <style> in <head> (no body-level <style> -> no CSS text)
        * tables instead of flexbox/grid
        * no @import / @media; built-in fonts (serif + Helvetica)
        * width 100% within @page margins (no 850px clipping)
      Rendered by FedWorkbook_PreviewExt.saveAttachment(); pass ?id=<LeadId>.
      Built up page-by-page; mirrors FedWorkbook_Preview content.
      ============================================================
    -->
    <html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>Groves Federal Benefits and Retirement Analysis</title>
        <style type="text/css">
            @page { size: Letter; margin: 0.6cm; }

            body {
                font-family: 'Times New Roman', Georgia, serif;
                font-size: 11pt;
                color: #2b2b2b;
                line-height: 1.4;
            }

            /* ---- Full-bleed image pages (cover / back cover) ---- */
            .gfgp-cover { page-break-after: always; }
            .gfgp-cover img { width: 100%; height: auto; }

            /* ---- One workbook sheet = a 2-column table (rail + body) ---- */
            .gfgp-sheet { width: 100%; border-collapse: collapse; page-break-after: always; }
            .gfgp-rail { width: 30px; background-color: #3A5754; }
            .gfgp-body { vertical-align: top; padding: 0 10px; }
            .gfgp-pageno {
                color: #ffffff;
                font-family: 'Helvetica', Arial, sans-serif;
                font-size: 22pt;
                font-weight: bold;
                text-align: center;
                padding: 0 0 10pt;
            }

            /* ---- Titles + accent bar ---- */
            .gfgp-title {
                color: #3A5754;
                font-family: 'Helvetica', Arial, sans-serif;
                font-size: 21pt;
                font-weight: bold;
                margin: 0 0 4pt;
            }
            .gfgp-accent {
                height: 8px;
                line-height: 8px;
                font-size: 1px;
                background-color: #8FA68C;
                margin: 0 0 12pt;
            }
            .gfgp-h2 {
                font-family: 'Helvetica', Arial, sans-serif;
                font-size: 14pt;
                font-weight: bold;
                color: #2b2b2b;
                margin: 14pt 0 6pt;
            }

            /* ---- Body copy ---- */
            .gfgp-p { text-align: justify; margin: 7pt 0; }
            .gfgp-center { text-align: center; }
            .gfgp-italic { font-style: italic; }
            .gfgp-rule { border: 0; border-top: 2px solid #8FA68C; margin: 12pt 0; }
            .gfgp-link { color: #1d4ed8; text-decoration: underline; }

            /* ---- Label/value info grid ---- */
            .gfgp-info { width: 100%; border-collapse: collapse; table-layout: fixed; }
            .gfgp-info td { padding: 2pt 6pt 2pt 0; font-size: 10.5pt; vertical-align: bottom;
                            overflow: hidden; }
            .gfgp-lbl { font-weight: bold; }
            .gfgp-val { border-bottom: 1px solid #9aa6a3; }

            /* ---- Lists ---- */
            ul.gfgp-ul, ol.gfgp-ol { margin: 4pt 0 4pt 18pt; padding: 0; }
            ul.gfgp-ul li, ol.gfgp-ol li { margin: 3pt 0; }
            .gfgp-bold-li li { font-weight: bold; }

            /* ---- Data tables (rate / projection / comparison) ---- */
            .gfgp-tab { width: 100%; border-collapse: collapse; margin: 8pt 0; font-size: 10pt; }
            .gfgp-tab th { background-color: #3A5754; color: #ffffff; padding: 4pt 6pt; text-align: center; border: 1px solid #ffffff; }
            .gfgp-tab td { padding: 3pt 6pt; text-align: center; border: 1px solid #cccccc; }
            .gfgp-tab--rate th { background-color: #B91C1C; color: #ffffff; font-weight: bold; }
            .gfgp-tab--rate td { background-color: #4B5563; color: #ffffff; }
            .gfgp-tab tfoot td { background-color: #4B5563; color: #ffffff; font-weight: bold; }

            /* ---- Option B future-cost projection table ---- */
            .gfgp-proj { width: 100%; border-collapse: collapse; margin: 8pt 0 2pt; font-size: 9pt; }
            .gfgp-proj th, .gfgp-proj td { padding: 4pt 5pt; text-align: center; border: 1px solid #ffffff; }
            .gfgp-proj thead th { background-color: #3A5754; color: #ffffff; font-weight: bold; }
            .gfgp-proj thead th.ageband { background-color: #B91C1C; }
            .gfgp-proj tbody td { background-color: #A5BFA1; color: #2b2b2b; }
            .gfgp-proj tbody td.age { background-color: #B91C1C; color: #ffffff; font-weight: bold; }
            .gfgp-proj tfoot td { background-color: #4B5563; color: #ffffff; font-weight: bold; }
            .gfgp-rate-note { text-align: center; font-size: 9pt; font-weight: bold; margin: 4pt 0 10pt; }

            /* ---- Option B Coverage projection (page 5b) ---- */
            .gfgp-obproj { width: 100%; border-collapse: collapse; margin: 6pt 0 2pt; font-size: 9pt; }
            .gfgp-obproj th, .gfgp-obproj td { padding: 4pt 5pt; text-align: center; border: 1px solid #ffffff; }
            .gfgp-obproj thead th { background-color: #3A5754; color: #ffffff; font-weight: bold; }
            .gfgp-obproj thead th.title { background-color: #8FA68C; color: #2b2b2b; }
            .gfgp-obproj thead th.ageband { background-color: #B91C1C; }
            .gfgp-obproj tbody td { background-color: #A5BFA1; color: #2b2b2b; }
            .gfgp-obproj tbody td.age { background-color: #B91C1C; color: #ffffff; font-weight: bold; }
            .gfgp-obproj tbody td.yrs { background-color: #ffffff; color: #2b2b2b; }
            .gfgp-obproj tfoot td { background-color: #3A5754; color: #ffffff; font-weight: bold; }
            .gfgp-obproj tfoot td.yrs { background-color: #A5BFA1; color: #2b2b2b; }
            .gfgp-obproj tfoot td.grand { background-color: #B91C1C; color: #ffffff; }

            .gfgp-obcmp { width: 100%; border-collapse: collapse; margin: 6pt 0; font-size: 9.5pt; }
            .gfgp-obcmp td, .gfgp-obcmp th { padding: 5pt 8pt; border: 1px solid #ffffff; }
            .gfgp-obcmp th { background-color: #3A5754; color: #ffffff; font-weight: bold; text-align: center; }
            .gfgp-obcmp td.lbl { background-color: #FDE700; color: #2b2b2b; text-align: right; font-weight: bold; }
            .gfgp-obcmp td.yrs { background-color: #A5BFA1; color: #2b2b2b; text-align: center; font-weight: bold; }
            .gfgp-obcmp td.val { background-color: #A5BFA1; color: #2b2b2b; text-align: center; font-weight: bold; }
            .gfgp-obcmp td.save { background-color: #51D235; color: #ffffff; text-align: center; font-weight: bold; }
            .gfgp-obcmp td.benefit { background-color: #ffffff; color: #2b2b2b; text-align: center; font-weight: bold; }

            .gfgp-obprop { width: 100%; border-collapse: collapse; margin: 10pt 0 2pt; font-size: 8.5pt; }
            .gfgp-obprop td, .gfgp-obprop th { padding: 5pt 5pt; text-align: center; border: 1px solid #ffffff; }
            .gfgp-obprop th { background-color: #8FA68C; color: #2b2b2b; font-weight: bold; }
            .gfgp-obprop td.title { background-color: #3A5754; color: #ffffff; font-weight: bold; }
            .gfgp-obprop td.years { background-color: #A5BFA1; color: #2b2b2b; font-weight: bold; }
            .gfgp-obprop td.rowlabel { background-color: #8FA68C; color: #2b2b2b; font-weight: bold; }
            .gfgp-obprop td.calc { background-color: #A5BFA1; color: #2b2b2b; font-weight: bold; }
            .gfgp-obprop td.save { background-color: #51D235; color: #ffffff; font-weight: bold; }

            /* ---- FERS red factor bullets ---- */
            ul.gfgp-red-ul { margin: 4pt 0 4pt 18pt; padding: 0; color: #B91C1C; }
            ul.gfgp-red-ul li { margin: 3pt 0; font-weight: bold; }

            /* ---- FERS eligibility (MRA) table ---- */
            .gfgp-elig { width: 100%; border-collapse: collapse; margin: 8pt 0 4pt; font-size: 8pt; }
            .gfgp-elig th { background-color: #3A5754; color: #ffffff; font-weight: bold; padding: 4pt 4pt; text-align: center; border: 1px solid #ffffff; }
            .gfgp-elig td { background-color: #A5BFA1; color: #ffffff; padding: 3pt 5pt; text-align: center; border: 1px solid #ffffff; vertical-align: middle; }
            .gfgp-elig td.gray { background-color: #4B5563; }
            .gfgp-elig td.red { background-color: #B91C1C; }
            .gfgp-elig .note { display: block; font-style: italic; font-size: 7pt; margin-top: 2pt; }

            /* ---- FERS scenario grid (borderless, underline-blank look) ---- */
            .gfgp-sc { width: 100%; border-collapse: collapse; margin: 16pt 0 0; }
            .gfgp-sc > tbody > tr > td { border: none; padding: 5pt 6pt; vertical-align: bottom; font-size: 11pt; }
            .gfgp-sc .lhead { text-align: left; }
            .gfgp-sc .schead { text-align: center; font-weight: bold; font-size: 14pt; padding-bottom: 6pt; }
            .gfgp-scin { width: 100%; border-collapse: collapse; }
            .gfgp-scin td { border: none; padding: 0 3pt; vertical-align: bottom; font-size: 11pt; }
            .gfgp-scin .lab { text-align: left; white-space: nowrap; }
            .gfgp-scin .op { white-space: nowrap; }
            .gfgp-scin .blank { border-bottom: 1px solid #2b2b2b; text-align: center; font-weight: bold; color: #1f3b38; width: 60%; }
            .gfgp-scin .blank.red { color: #B91C1C; }
            .gfgp-scin .sub { text-align: left; font-size: 8.5pt; font-style: italic; color: #4B5563; white-space: nowrap; }
            .gfgp-sc .lhead.red { color: #B91C1C; }
            .gfgp-sc .schead .pri { display: block; font-size: 9pt; font-weight: bold; color: #B91C1C; }
            /* Top "current values" summary banner above the scenario grid */
            .gfgp-scsum { width: 100%; border-collapse: collapse; margin: 14pt 0 0; }
            .gfgp-scsum td { border: none; border-bottom: 1.5pt solid #8FA68C; padding: 3pt 6pt 7pt; font-size: 10pt; text-align: center; }
            .gfgp-scsum td b { color: #3A5754; }
            .gfgp-scsum .v { color: #1f3b38; font-weight: bold; }

            /* ---- FERS survivor: 4-column comparison grid ---- */
            .gfgp-cmp { width: 100%; border-collapse: collapse; margin: 10pt 0 14pt; }
            .gfgp-cmp td { padding: 7pt 6pt 2pt; text-align: center; vertical-align: bottom; font-size: 10pt; }
            .gfgp-cmp td.l { text-align: left; }
            .gfgp-cmp .vblank { display: block; border-bottom: 1px solid #2b2b2b; font-weight: bold; color: #1f3b38; padding-bottom: 2pt; }
            .gfgp-cmp tr.hd td { color: #2E5395; font-weight: bold; font-size: 8.5pt; border-top: 1px solid #2b2b2b; padding: 3pt 6pt 7pt; vertical-align: top; }
            .gfgp-cmp tr.hd td.l { text-align: left; }

            /* ---- FERS survivor: Min/Max benefit boxes ---- */
            .gfgp-survbox { border: 1px solid #cccccc; padding: 8pt 12pt 12pt; }
            .gfgp-survbox__title { font-weight: bold; text-align: center; font-size: 11pt; margin: 0 0 8pt; }
            .gfgp-survcap { text-align: center; color: #B91C1C; font-size: 10pt; line-height: 1.5; margin-top: 10pt; }
            .gfgp-survcap .u { border-bottom: 1px solid #B91C1C; font-weight: bold; padding: 0 6pt; }

            /* ---- Special Groups inline formula calc ---- */
            .gfgp-fcalc { border-collapse: collapse; margin: 4pt auto; }
            .gfgp-fcalc td { border: none; padding: 2pt 5pt; font-size: 10pt; vertical-align: bottom; text-align: center; white-space: nowrap; }
            .gfgp-fcalc td.b { border-bottom: 1px solid #2b2b2b; font-weight: bold; color: #1f3b38; }
            .gfgp-fcalc .sub { display: block; font-size: 8pt; font-style: italic; font-weight: normal; color: #2b2b2b; }
            .gfgp-eg { text-align: center; font-size: 9.5pt; margin: 3pt 0; }
            .gfgp-eg-total { text-align: center; font-size: 9.5pt; font-weight: bold; margin: 4pt 0; }
            .gfgp-li-red { color: #B91C1C; }
            .gfgp-calc-section { border-top: 1px solid #d0d0d0; padding-top: 10pt; margin-top: 12pt; }

            /* ---- TSP contribution limits / matching ---- */
            .gfgp-uhead { font-weight: bold; text-decoration: underline; font-size: 10pt; margin: 0 0 4pt; }
            .gfgp-contrib { width: 100%; border-collapse: collapse; }
            .gfgp-contrib td { border: none; padding: 2pt 4pt; font-size: 10pt; vertical-align: bottom; }
            .gfgp-contrib .val { border-bottom: 1px solid #2b2b2b; text-align: center; color: #1f3b38; width: 38%; }
            .gfgp-contrib .sub { font-size: 8pt; font-style: italic; color: #555; }
            .gfgp-tspnote { font-size: 8.5pt; font-style: italic; color: #444; margin: 6pt 0; }
            .gfgp-circ { list-style: circle; margin: 2pt 0 2pt 16pt; padding: 0; }
            .gfgp-circ li { font-size: 9pt; margin: 2pt 0; }
            .gfgp-tspopt { text-align: center; color: #B91C1C; font-weight: bold; text-decoration: underline; font-size: 10.5pt; padding: 2pt 18pt; }
            .gfgp-linkrow { font-size: 9.5pt; margin: 4pt 0; }

            /* ---- Military Time Recapture table ---- */
            .gfgp-mtr { width: 100%; border-collapse: collapse; margin-top: 8pt; font-size: 9.5pt; }
            .gfgp-mtr td { background-color: #3A5754; color: #ffffff; padding: 6pt 10pt; border: 1px solid #ffffff; vertical-align: middle; }
            .gfgp-mtr .hdr { text-align: center; font-family: 'Helvetica', Arial, sans-serif; font-weight: bold; font-size: 13pt; letter-spacing: 1px; }
            .gfgp-mtr .branch { text-align: center; width: 120px; }

            /* ---- Financial Snapshot underline-blank rows ---- */
            .gfgp-snap { width: 100%; border-collapse: collapse; margin: 2pt 0; }
            .gfgp-snap td { border: none; padding: 3pt 4pt; font-size: 10.5pt; vertical-align: bottom; }
            .gfgp-snap .lab { width: 36%; }
            .gfgp-snap .sign { width: 16pt; text-align: center; font-weight: bold; }
            .gfgp-snap .uval { border-bottom: 1px solid #2b2b2b; text-align: center; color: #1f3b38; width: 22%; }
            .gfgp-snap .extra { font-size: 9pt; color: #555; padding-left: 10pt; }
            .gfgp-snap .extra .u { display: inline-block; min-width: 70pt; border-bottom: 1px solid #2b2b2b; text-align: center; color: #1f3b38; padding: 0 4pt; }
            .gfgp-snap tr.tot td { font-weight: bold; }
            .gfgp-snap .ne { font-style: italic; font-weight: bold; }
            .gfgp-snap .opt { font-size: 8pt; font-weight: bold; color: #b00020; }
            .gfgp-seclabel { font-family: 'Helvetica', Arial, sans-serif; font-size: 9pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #3A5754; border-bottom: 1px solid #d0d0d0; padding-bottom: 3pt; margin: 10pt 0 4pt; }

            /* ---- Total Basic &amp; Optional Life Insurance summary ---- */
            .gfgp-summary { width: 100%; border-collapse: collapse; margin: 6pt 0; }
            .gfgp-summary td { padding: 4pt 6pt; font-size: 10.5pt; vertical-align: bottom; }
            .gfgp-summary .lbl { width: 22%; }
            .gfgp-summary .cell { border-bottom: 1px solid #9aa6a3; text-align: center; }
            .gfgp-summary .colhead { font-style: italic; color: #555; text-align: center; border-bottom: none; }
            .gfgp-summary .total td { font-weight: bold; }
            .gfgp-bottom-note { text-align: center; font-size: 9pt; margin: 10pt 0 0; background-color: #f6f1e9; padding: 8pt; }

            /* ---- Calculation rows ---- */
            .gfgp-calc { width: 100%; border-collapse: collapse; }
            .gfgp-calc td { padding: 3pt 4pt; font-size: 10.5pt; vertical-align: bottom; }
            .gfgp-calc .v { border-bottom: 1px solid #2b2b2b; font-weight: bold; text-align: right; }
            .gfgp-cost { color: #B91C1C; font-weight: bold; }
            .gfgp-amt { font-weight: bold; text-decoration: underline; }
            .gfgp-h3 { font-weight: bold; font-size: 12pt; margin: 12pt 0 4pt; }
            .gfgp-center-h { text-align: center; font-weight: bold; font-size: 13pt; margin: 12pt 0 4pt; }

            /* ---- Survivor "Points to Consider" callout ---- */
            .gfgp-callout { background-color: #3A5754; color: #ffffff; padding: 8pt 12pt; margin: 6pt 0; }
            .gfgp-callout-title { font-family: 'Helvetica', Arial, sans-serif; font-weight: bold; text-align: center; margin: 0 0 4pt; }
        </style>
    </head>
    <body>

        <!-- ============ Page 1: Cover ============ -->
        <div class="gfgp-cover">
            <apex:image url="{!$Resource.Pg1GrovesFedForm}"
                alt="Groves Financial Group - Federal Employee Benefits and Retirement Workbook" />
        </div>

        <!-- ============ Page 2: Federal Employee Information ============ -->
        <table class="gfgp-sheet">
            <tr>
                <td class="gfgp-rail" valign="bottom"><div class="gfgp-pageno">2</div></td>
                <td class="gfgp-body">
                    <div class="gfgp-title">Federal Benefits &amp; Retirement Analysis</div>
                    <div class="gfgp-accent"></div>

                    <table class="gfgp-info">
                        <colgroup><col style="width:15%" /><col style="width:35%" /><col style="width:15%" /><col style="width:35%" /></colgroup>
                        <tr>
                            <td class="gfgp-lbl">Date:</td>
                            <td class="gfgp-val"><apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!TODAY()}" /></apex:outputText></td>
                            <td class="gfgp-lbl">Specialist:</td>
                            <td class="gfgp-val">{!$User.FirstName} {!$User.LastName}</td>
                        </tr>
                        <tr>
                            <td class="gfgp-lbl">Phone:</td>
                            <td class="gfgp-val">{!$User.Phone}</td>
                            <td class="gfgp-lbl">Email:</td>
                            <td class="gfgp-val">{!$User.Email}</td>
                        </tr>
                    </table>

                    <p class="gfgp-center gfgp-italic" style="margin:8pt 0;">
                        Information used in this analysis is provided by the federal employee
                    </p>

                    <table class="gfgp-info">
                        <colgroup><col style="width:18%" /><col style="width:32%" /><col style="width:18%" /><col style="width:32%" /></colgroup>
                        <!-- Identity -->
                        <tr>
                            <td class="gfgp-lbl">Name:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Name}" /></td>
                            <td class="gfgp-lbl">Email:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Email}" /></td>
                        </tr>
                        <tr>
                            <td class="gfgp-lbl">Phone:</td>
                            <td class="gfgp-val" colspan="3"><apex:outputField value="{!Lead.MobilePhone_Formatted__c}" /></td>
                        </tr>
                        <!-- Address -->
                        <tr>
                            <td class="gfgp-lbl">Address:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Street}" /></td>
                            <td class="gfgp-lbl">City:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.City}" /></td>
                        </tr>
                        <tr>
                            <td class="gfgp-lbl">State:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.State}" /></td>
                            <td class="gfgp-lbl">Zip:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.PostalCode}" /></td>
                        </tr>
                        <!-- Employment -->
                        <tr>
                            <td class="gfgp-lbl">Job Title:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Title}" /></td>
                            <td class="gfgp-lbl">Agency:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Company}" /></td>
                        </tr>
                        <tr>
                            <td class="gfgp-lbl">Date of Hire:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Date_of_Hire__c}" /></td>
                            <td class="gfgp-lbl">Exp. Retirement Date:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Expected_Retirement_Date__c}" /></td>
                        </tr>
                        <!-- DOB + derived -->
                        <tr>
                            <td class="gfgp-lbl">DOB:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Date_of_Birth__c}" /></td>
                            <td class="gfgp-lbl">Current Age:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Contact_Age__c}" /></td>
                        </tr>
                        <tr>
                            <td class="gfgp-lbl">Years of Creditable Service:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Years_of_Employment__c}" /></td>
                            <td class="gfgp-lbl">Expected Retirement Age:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Expected_Retirement_Age__c}" /></td>
                        </tr>
                        <!-- Marital / Spouse / Federal Employee -->
                        <tr>
                            <td class="gfgp-lbl">Marital Status:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Marital_Status__c}" /></td>
                            <td class="gfgp-lbl">
                                <apex:outputText value="Spouse Name:" rendered="{!OR(Lead.Marital_Status__c == 'Married', Lead.Marital_Status__c == 'Registered Partnership')}" />
                            </td>
                            <td class="gfgp-val">
                                <apex:outputText value="{!Lead.Spouse_Name__r.Name}" rendered="{!OR(Lead.Marital_Status__c == 'Married', Lead.Marital_Status__c == 'Registered Partnership')}" />
                            </td>
                        </tr>
                        <tr>
                            <td class="gfgp-lbl">Federal Employee:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Federal_Employee__c}" /></td>
                            <td class="gfgp-lbl">Affiliation:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Affiliation__c}" /></td>
                        </tr>
                        <!-- Base Salary + Salary Interval -->
                        <tr>
                            <td class="gfgp-lbl">Base Salary:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Base_Salary__c}" /></td>
                            <td class="gfgp-lbl">Salary Interval:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.Salary_Interval__c}" /></td>
                        </tr>
                        <!-- Retirement System -->
                        <tr>
                            <td class="gfgp-lbl">Retirement System:</td>
                            <td class="gfgp-val" colspan="3">
                                FERS [<apex:outputText value="{!IF(Lead.FERS__c, 'X', ' ')}" />]
                                Special Groups [<apex:outputText value="{!IF(Lead.Special_Group_Member__c, 'X', ' ')}" />]
                            </td>
                        </tr>
                        <!-- TSP Balance ($) + contribution (% or $ mode) -->
                        <tr>
                            <td class="gfgp-lbl">TSP Balance:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.TSP_Total__c}" /></td>
                            <td class="gfgp-lbl">
                                <apex:outputText value="TSP Contribution (%):" rendered="{!Lead.percTSP__c == true}" />
                                <apex:outputText value="TSP Contribution ($):" rendered="{!Lead.dollarTSP__c == true}" />
                            </td>
                            <td class="gfgp-val">
                                <apex:outputField value="{!Lead.TSP_Contribution__c}" rendered="{!Lead.percTSP__c == true}" />
                                <apex:outputField value="{!Lead.Monthly_Contribution__c}" rendered="{!Lead.dollarTSP__c == true}" />
                                <apex:outputText value=" + 5% Govt. Match" styleClass="gfgp-cost"
                                    rendered="{!(Lead.TSP_Contribution__c != null && Lead.TSP_Contribution__c >= 0.05 && Lead.percTSP__c == true) || (Lead.ROTH_TSP_Contribution__c != null && Lead.ROTH_TSP_Contribution__c >= 0.05 && Lead.percROTH__c == true)}" />
                            </td>
                        </tr>
                        <!-- Tax-Free (Roth) TSP Balance ($) + contribution (% or $ mode) -->
                        <tr>
                            <td class="gfgp-lbl">Tax-Free TSP Balance:</td>
                            <td class="gfgp-val"><apex:outputField value="{!Lead.ROTH_Total__c}" /></td>
                            <td class="gfgp-lbl">
                                <apex:outputText value="ROTH TSP Contribution (%):" rendered="{!Lead.percROTH__c == true}" />
                                <apex:outputText value="ROTH TSP Contribution ($):" rendered="{!Lead.dollarROTH__c == true}" />
                            </td>
                            <td class="gfgp-val">
                                <apex:outputField value="{!Lead.ROTH_TSP_Contribution__c}" rendered="{!Lead.percROTH__c == true}" />
                                <apex:outputField value="{!Lead.Monthly_ROTH_Contribution__c}" rendered="{!Lead.dollarROTH__c == true}" />
                            </td>
                        </tr>
                        <!-- FEGLI Code -->
                        <tr>
                            <td class="gfgp-lbl">FEGLI Code:</td>
                            <td class="gfgp-val" colspan="3"><apex:outputField value="{!Lead.FEGLI_Code_Picklist__c}" /></td>
                        </tr>
                        <!-- FEGLI Plan -->
                        <tr>
                            <td class="gfgp-lbl">FEGLI Plan:</td>
                            <td class="gfgp-val" colspan="3">
                                <!-- Marks derived the same way as the interactive page: when no FEGLI code
                                     ('--') the stored Basic__c/OptionA__c/OptionB__c/OptionC__c booleans drive
                                     the X; when a code is set the X is derived from the code's letters/digits. -->
                                Basic [<apex:outputText value="{!IF(Lead.FEGLI_Code_Picklist__c == '--', IF(Lead.Basic__c, 'X', ' '), IF(Lead.FEGLI_Code_Picklist__c != '' && Lead.FEGLI_Code_Picklist__c != 'Ao' && Lead.FEGLI_Code_Picklist__c != 'Bo', 'X', ' '))}" />]&#160;&#160;
                                Option A [<apex:outputText value="{!IF(Lead.FEGLI_Code_Picklist__c == '--', IF(Lead.OptionA__c, 'X', ' '), IF((Lead.FEGLI_Code_Picklist__c != '' && Lead.FEGLI_Code_Picklist__c != 'Ao' && Lead.FEGLI_Code_Picklist__c != 'Bo' && Lead.FEGLI_Code_Picklist__c != 'Co' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'E')) && Lead.FEGLI_Code_Picklist__c != 'Go' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'I')) && Lead.FEGLI_Code_Picklist__c != 'Ko' && Lead.FEGLI_Code_Picklist__c != 'Lo' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'M')) && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Q')) && Lead.FEGLI_Code_Picklist__c != 'So' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'U')) && Lead.FEGLI_Code_Picklist__c != 'Wo' && Lead.FEGLI_Code_Picklist__c != 'Xo' && NOT(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Y'))) || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'F') || Lead.FEGLI_Code_Picklist__c == 'Ho' || Lead.FEGLI_Code_Picklist__c == 'Do' || Lead.FEGLI_Code_Picklist__c == 'Lo', 'X', ' '))}" />]&#160;&#160;
                                Option B [<apex:outputText value="{!IF(Lead.FEGLI_Code_Picklist__c == '--', IF(Lead.OptionB__c, 'X', ' '), IF(CONTAINS(Lead.FEGLI_Code_Picklist__c, 'G') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'H') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'I') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'J') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'K') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'L') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'M') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'N') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'P') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Q') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'R') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'S') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'T') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'U') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'V') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'W') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'X') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Y') || CONTAINS(Lead.FEGLI_Code_Picklist__c, 'Z'), 'X', ' '))}" />]
                                <apex:outputField value="{!Lead.Option_B_Choice_Selection__c}" />&#160;&#160;
                                Option C [<apex:outputText value="{!IF(Lead.FEGLI_Code_Picklist__c == '--', IF(Lead.OptionC__c, 'X', ' '), IF(CONTAINS(Lead.FEGLI_Code_Picklist__c, '1') || CONTAINS(Lead.FEGLI_Code_Picklist__c, '2') || CONTAINS(Lead.FEGLI_Code_Picklist__c, '3') || CONTAINS(Lead.FEGLI_Code_Picklist__c, '4') || CONTAINS(Lead.FEGLI_Code_Picklist__c, '5'), 'X', ' '))}" />]
                                <apex:outputField value="{!Lead.Option_C_Choice_Selection__c}" />
                            </td>
                        </tr>
                    </table>

                    <hr class="gfgp-rule" />

                    <p class="gfgp-p">
                        The objective of this workbook is to give the Federal Employee a working
                        knowledge of their current core benefits. It is not intended to offer tax
                        or investing advice. Understanding how the federal retirement system works
                        will offer you invaluable insight and the ability to make an informed
                        decision when the time comes to plan for your retirement. Your retirement
                        income is based on the system you are employed under, either CSRS, CSRS
                        Offset, or FERS. While it is important to understand how this works, it is
                        equally important to understand your other core benefits, what they are,
                        how they affect your income during your working years, and how to maximize
                        your pension into retirement.
                    </p>

                    <div class="gfgp-h2 gfgp-center">The first steps in developing a financial strategy involve understanding:</div>
                    <table style="width:100%;"><tr>
                        <td style="vertical-align:top;width:50%;">
                            <ul class="gfgp-ul"><li>What you have</li><li>What you want</li><li>What your costs will be</li></ul>
                        </td>
                        <td style="vertical-align:top;width:50%;">
                            <ul class="gfgp-ul"><li>What you need</li><li>What your income will be</li><li>What your options are</li></ul>
                        </td>
                    </tr></table>

                    <div class="gfgp-h2 gfgp-center">During this review we will cover the following core benefits that apply to you:</div>
                    <table style="width:100%;"><tr>
                        <td style="vertical-align:top;width:50%;">
                            <ul class="gfgp-ul"><li>Your Federal Retirement System</li><li>Retirement Annuity</li><li>FERS Supplement Annuity</li><li>Thrift Savings Plan</li></ul>
                        </td>
                        <td style="vertical-align:top;width:50%;">
                            <ul class="gfgp-ul"><li>Social Security Annuity</li><li>Federal Employee Group Life Insurance</li><li>Survivor Benefits Plan</li></ul>
                        </td>
                    </tr></table>
                </td>
            </tr>
        </table>

        <!-- ============ Page 3: FEGLI Basic Life ============ -->
        <apex:outputPanel layout="none"
            rendered="{!Lead.Basic__c == true || (Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != 'Ao' && Lead.FEGLI_Code_Picklist__c != 'Bo')}">
        <table class="gfgp-sheet">
            <tr>
                <td class="gfgp-body">
                    <div class="gfgp-title">Federal Employee Group Life Insurance</div>
                    <div class="gfgp-accent"></div>

                    <p class="gfgp-p">
                        FEGLI is a Group Term Life Insurance offered to most federal employees, administered by the
                        Office of Federal Employees' Group Life Insurance (OFEGLI), the administrative unit of
                        Metropolitan Life Insurance Company, which is under contract with the Office of Personnel
                        Management (OPM). A complete FEGLI Program Handbook can be downloaded at:
                    </p>
                    <p class="gfgp-center"><a class="gfgp-link" href="http://www.opm.gov/healthcare-insurance/life-insurance/reference-materials/handbook.pdf">http://www.opm.gov/healthcare-insurance/life-insurance/reference-materials/handbook.pdf</a></p>
                    <p class="gfgp-p">
                        It is understood that neither OPM nor OFEGLI endorses any kind of privately-sponsored insurance
                        plan. Employees are free to purchase whatever life insurance they choose. Comparison shopping is
                        encouraged. GFG is an independent company offering alternatives to FEGLI and not affiliated with
                        OPM or OFEGLI.
                    </p>
                    <p class="gfgp-p"><b>Basic -</b> As an eligible employee, you were automatically enrolled in Basic Life Insurance upon hiring, unless you waived this coverage. Under Basic Life Insurance you have three components:</p>
                    <p class="gfgp-p"><b>I. Basic Life -</b> The cost of Basic is shared between the employee and the Government. The employee pays two-thirds and the Government pays one-third. <u>The USPS pays the full cost of Basic for postal employees.</u> <b>The cost of basic is $0.16 biweekly and $0.3467 monthly per $1,000 of coverage.</b> There is no extra charge for the Extra Benefit or AD&amp;D.</p>
                    <p class="gfgp-p"><b>II. Extra Benefit</b> - (age Multiplication Factor) If you are under the age of 45 and covered by Basic, you automatically have extra coverage. (See chart)</p>
                    <p class="gfgp-p"><b>III. Accidental Death and Dismemberment</b> - (AD&amp;D) Accidental death benefits are equal to your Basic Life Insurance coverage. Accidental dismemberment benefits for the loss of a hand, foot, or eye are equal to half of the Basic Life Insurance Amount; however if you lose any two of these, the full amount is payable. There is no additional cost for this coverage.</p>

                    <table style="width:100%;"><tr>
                        <td style="width:55%;vertical-align:top;padding-right:10px;">
                            <table class="gfgp-calc">
                                <tr>
                                    <td><apex:outputText value="Current Age:" rendered="{!Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != '' && Lead.Basic__c == true}" /><apex:outputText value="Starting Age:" rendered="{!Lead.FEGLI_Code_Picklist__c == '--' && Lead.Basic__c == true}" /></td>
                                    <td class="v"><apex:outputText value="{!Lead.Contact_Age__c}" rendered="{!Lead.FEGLI_Code_Picklist__c != '--' && Lead.FEGLI_Code_Picklist__c != '' && Lead.Basic__c == true}" /><apex:outputText value="{!Lead.Age_Option_Basic_Manual__c}" rendered="{!Lead.FEGLI_Code_Picklist__c == '--' && Lead.Basic__c == true}" /></td>
                                </tr>
                                <tr><td>Base Pay Round Up:</td><td class="v"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!Lead.formula_basePay__c}" /></apex:outputText></td></tr>
                                <tr><td>Add $2000 = BIA Amount:</td><td class="v"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!Lead.formula_basePay__c + 2000}" /></apex:outputText></td></tr>
                                <tr><td>Extra Benefit Factor (Age 45 &amp; under):</td><td class="v"><apex:outputText value="{0, number, $#,##0.00}" rendered="{!blExtraBenefit != null}"><apex:param value="{!blExtraBenefit}" /></apex:outputText><apex:outputText value="--" rendered="{!blExtraBenefit == null}" /></td></tr>
                                <tr><td><b>Total Current Benefit:</b></td><td class="v"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!blTotalCurrentBenefit}" /></apex:outputText></td></tr>
                                <apex:outputPanel layout="none" rendered="{!blShowYearsRemaining}"><tr><td>Extra Benefit Years Remaining:</td><td class="v"><apex:outputText value="{0, number, #,##0}"><apex:param value="{!blExtraBenefitYearsRemaining}" /></apex:outputText></td></tr></apex:outputPanel>
                            </table>
                        </td>
                        <td style="width:45%;vertical-align:top;">
                            <table class="gfgp-tab gfgp-tab--rate">
                                <thead><tr><th>AGE</th><th>FACTOR</th><th>AGE</th><th>FACTOR</th></tr></thead>
                                <tbody>
                                    <tr><td>Under 35</td><td>1</td><td>40</td><td>0.5</td></tr>
                                    <tr><td>36</td><td>0.9</td><td>41</td><td>0.4</td></tr>
                                    <tr><td>37</td><td>0.8</td><td>42</td><td>0.3</td></tr>
                                    <tr><td>38</td><td>0.7</td><td>43</td><td>0.2</td></tr>
                                    <tr><td>39</td><td>0.6</td><td>44</td><td>0.1</td></tr>
                                </tbody>
                            </table>
                        </td>
                    </tr></table>

                    <div class="gfgp-center-h">Your Basic coverage, costs and options in retirement</div>
                    <p class="gfgp-center gfgp-italic">For illustration purposes, your FEGLI coverage reflects a salary increase of 1% annually from your current income. We advise that you reevaluate retirement costs when salary increases occur.</p>
                    <ul class="gfgp-ul">
                        <li>No Reduction - Coverage Amount <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!Lead.formula_basePay__c + 2000}" /></apex:outputText></span>
                            <ul><li>Cost Prior to age 65 <span class="gfgp-cost">$2.5967</span> X <apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!(Lead.formula_basePay__c + 2000) / 1000}" /></apex:outputText> = <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!((Lead.formula_basePay__c + 2000) / 1000) * 2.5967}" /></apex:outputText></span>&#160;&#160;&#160;After age 65 <span class="gfgp-cost">$2.25</span> X <apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!(Lead.formula_basePay__c + 2000) / 1000}" /></apex:outputText> = <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!((Lead.formula_basePay__c + 2000) / 1000) * 2.25}" /></apex:outputText></span></li></ul>
                        </li>
                        <li>50% Reduction <span class="gfgp-cost">(Reduces 1% per month starting at age 65)</span> Coverage after reduction <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!Lead.hiddenTotalBenefitformula__c / 2}" /></apex:outputText></span>
                            <ul><li>Cost Prior to age 65 <span class="gfgp-cost">$1.0967</span> X <apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!(Lead.formula_basePay__c + 2000) / 1000}" /></apex:outputText> = <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!((Lead.formula_basePay__c + 2000) / 1000) * 1.0967}" /></apex:outputText></span>&#160;&#160;&#160;After age 65 <span class="gfgp-cost">$0.75</span> X <apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!(Lead.formula_basePay__c + 2000) / 1000}" /></apex:outputText> = <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!((Lead.formula_basePay__c + 2000) / 1000) * 0.75}" /></apex:outputText></span></li></ul>
                        </li>
                        <li>75% Reduction <span class="gfgp-cost">(Reduces 2% per month starting at age 65)</span> Coverage after reduction <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!(Lead.hiddenTotalBenefitformula__c / 2) / 2}" /></apex:outputText></span>
                            <ul><li>Cost Prior to age 65 <span class="gfgp-cost">$0.3467</span> X <apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!(Lead.formula_basePay__c + 2000) / 1000}" /></apex:outputText> = <span class="gfgp-amt"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!((Lead.formula_basePay__c + 2000) / 1000) * 0.3467}" /></apex:outputText></span>&#160;&#160;&#160;<span class="gfgp-cost">After age 65 =</span> <b><u>NO COST</u></b></li></ul>
                        </li>
                    </ul>
                    <p class="gfgp-center" style="font-weight:bold;font-size:9pt;">**Rates are based on current FEGLI rates. Rates are subject to change.</p>
                </td>
                <td class="gfgp-rail" valign="bottom"><div class="gfgp-pageno">3</div></td>
            </tr>
        </table>
        </apex:outputPanel>

        <!-- ============ Page 4: FEGLI Option A and Option C ============ -->
        <apex:outputPanel layout="none" rendered="{!Lead.OptionA__c == true || Lead.OptionC__c == true}">
        <table class="gfgp-sheet">
            <tr>
                <td class="gfgp-rail" valign="bottom"><div class="gfgp-pageno">4</div></td>
                <td class="gfgp-body">
                    <!-- ===== Option A (rendered only when Option A active) ===== -->
                    <apex:outputPanel layout="none" rendered="{!Lead.OptionA__c == true || CONTAINS(Lead.FEGLI_Plan__c, 'Option A')}">
                    <div class="gfgp-title">FEGLI - Option A</div>
                    <div class="gfgp-accent"></div>
                    <p class="gfgp-p">Optional Life Insurance - Federal employees who are covered under Basic life insurance program may also elect to purchase one or all three of the Optional coverage plans.</p>
                    <p class="gfgp-p"><b>Option A</b> - Standard Optional Insurance - <span style="color:#B91C1C;">The employee pays the full cost</span> for this optional insurance which offers an additional $10,000 of FEGLI. Option A also offers an equal amount of AD&amp;D protection. Costs are age-based.</p>

                    <table style="width:100%;"><tr>
                        <td style="width:50%;vertical-align:top;padding-right:12px;">
                            <table class="gfgp-tab gfgp-tab--rate">
                                <thead><tr><th>Employee Age Band</th><th>Pay Mode factor<br/>Bi-Weekly</th><th>Pay Mode Factor<br/>Monthly</th></tr></thead>
                                <tbody>
                                    <tr><td>Under 35</td><td>$0.20</td><td>$0.43</td></tr>
                                    <tr><td>35-39</td><td>$0.20</td><td>$0.43</td></tr>
                                    <tr><td>40-44</td><td>$0.30</td><td>$0.65</td></tr>
                                    <tr><td>45-49</td><td>$0.60</td><td>$1.30</td></tr>
                                    <tr><td>50-54</td><td>$1.00</td><td>$2.17</td></tr>
                                    <tr><td>55-59</td><td>$1.80</td><td>$3.90</td></tr>
                                    <tr><td>60 Plus</td><td>$6.00</td><td>$13.00</td></tr>
                                </tbody>
                            </table>
                        </td>
                        <td style="width:50%;vertical-align:top;text-align:center;">
                            <div class="gfgp-center-h" style="text-decoration:underline;">Option A - After Retirement</div>
                            <p class="gfgp-center gfgp-italic">The amount of your Option A life insurance decreases at age 65 or at retirement, whichever is later, at a rate of 2% per month until a 75% reduction is reached.</p>
                            <apex:image url="{!$Resource.Pg5GrovesArrow}" width="180" alt="Option A coverage decreases from $10,000 to $2,500" />
                            <p class="gfgp-center" style="margin-top:10pt;">Option A Cost: <span class="gfgp-cost">$</span> <span class="gfgp-amt"><apex:outputText value="{0, number, 0.00}"><apex:param value="{!acOptionACost}" /></apex:outputText></span></p>
                        </td>
                    </tr></table>
                    </apex:outputPanel>

                    <!-- ===== Option C (rendered only when Option C active) ===== -->
                    <apex:outputPanel layout="none" rendered="{!Lead.OptionC__c == true || CONTAINS(Lead.FEGLI_Plan__c, 'Option C')}">
                    <div class="gfgp-title" style="margin-top:14pt;">FEGLI - Option C</div>
                    <div class="gfgp-accent"></div>
                    <p class="gfgp-p"><b>Option C</b> - Family Optional Insurance - <span style="color:#B91C1C;">The employee pays the full cost</span> for optional family coverage. This coverage insures the lives of your spouse and eligible dependent children. You have the option of one to five multiples. <span style="color:#B91C1C;">Each multiple is equal to $5,000 for your spouse and $2,500 for each eligible dependent child.</span></p>
                    <p class="gfgp-p">"Eligible family members" means your present spouse, and your unmarried dependent child, including an adopted child, a stepchild or a recognized natural child who is living with you, or who is receiving regular and substantial support from you. To be covered, a child must be under 22 years of age, or be 22 or over and incapable of self-support because of mental or physical disability, which existed before the child became 22 years of age.</p>

                    <table style="width:100%;"><tr>
                        <td style="width:50%;vertical-align:top;padding-right:12px;">
                            <table class="gfgp-calc">
                                <tr><td>Number of Multiples:</td><td class="v"><apex:outputText value="{!acOptionCMultiples}" /></td></tr>
                                <tr><td>Spouse Benefit:</td><td class="v"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!acOptionCMultiples * 5000}" /></apex:outputText></td></tr>
                                <tr><td>Each Child Benefit:</td><td class="v"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!acOptionCMultiples * 2500}" /></apex:outputText></td></tr>
                                <tr><td>Multiples <apex:outputText value="{0, number, #0}"><apex:param value="{!acOptionCMultiples}" /></apex:outputText> X Factor <apex:outputText value="{0, number, #0.00}"><apex:param value="{!acOptionCBiWeeklyFactor}" /></apex:outputText> =</td><td class="v"><apex:outputText value="{0, number, $#,##0.00}"><apex:param value="{!acOptionCMultiples * acOptionCBiWeeklyFactor}" /></apex:outputText></td></tr>
                            </table>
                        </td>
                        <td style="width:50%;vertical-align:top;">
                            <table class="gfgp-tab gfgp-tab--rate">
                                <thead><tr><th>Age Band</th><th>Bi-Weekly Factor</th><th>Monthly Factor</th></tr></thead>
                                <tbody>
                                    <tr><td>Under 35</td><td>$0.20</td><td>$0.43</td></tr>
                                    <tr><td>35-39</td><td>$0.24</td><td>$0.52</td></tr>
                                    <tr><td>40-44</td><td>$0.37</td><td>$0.80</td></tr>
                                    <tr><td>45-49</td><td>$0.53</td><td>$1.15</td></tr>
                                    <tr><td>50-54</td><td>$0.83</td><td>$1.80</td></tr>
                                    <tr><td>55-59</td><td>$1.33</td><td>$2.88</td></tr>
                                    <tr><td>60-64</td><td>$2.43</td><td>$5.27</td></tr>
                                    <tr><td>65-69</td><td>$2.83</td><td>$6.13</td></tr>
                                    <tr><td>70-74</td><td>$3.83</td><td>$8.30</td></tr>
                                    <tr><td>75-79</td><td>$5.76</td><td>$12.48</td></tr>
                                    <tr><td>80- Plus</td><td>$7.80</td><td>$16.90</td></tr>
                                </tbody>
                            </table>
                        </td>
                    </tr></table>

                    <p class="gfgp-p" style="margin-top:12pt;"><b>Continuation Of Option B and C After Retirement</b></p>
