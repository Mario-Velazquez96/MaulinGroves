<apex:page id="formB5" standardController="Lead" extensions="FedWorkbook_OptionBExt"
    showHeader="false" sidebar="false" standardStylesheets="false"
    applyHtmlTag="false" applyBodyTag="false"
    docType="html-5.0" title="FEGLI - Option B"
    rendered="{!Lead.OptionB__c == true || CONTAINS(Lead.FEGLI_Plan__c, 'Option B')}">
    <!--
      ============================================================
      FedWorkbook_OptionB  (Page 5)
      Rebranded FEGLI Option B section.
      Uses the FedWorkbook_OptionBExt extension to compute Option B
      coverage and costs. Same Lead fields as the original OptionB.page:
        formula_basePay__c, Multiples_B_Manual__c, Contact_Age__c,
        Age_Option_B_Manual__c, FEGLI_Code_Picklist__c, OptionB__c
      Plus FEGLI_Plan__c for the new multi-select picklist path.
      ============================================================
    -->

    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=PT+Serif:wght@400;700&amp;display=swap');

        .gfg5-doc {
            position: relative;
            background: #ffffff;
            color: #2b2b2b;
            font-family: 'PT Serif', Georgia, 'Times New Roman', serif;
            font-size: 14px;
            line-height: 1.55;
            margin: 0 auto 24px;
            width: 850px;
            max-width: 100%;
            box-sizing: border-box;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        }
        /* Right-side sidebar */
        .gfg5-sidebar { position: absolute; right: 0; top: 0; bottom: 0; width: 54px; background: #3A5754; }
        .gfg5-pagenum {
            position: absolute; bottom: 18px; right: 0; width: 54px;
            text-align: center; color: #ffffff;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 30px; font-weight: 800;
        }
        .gfg5-main { margin-right: 54px; padding: 26px 38px 30px; }

        .gfg5-title {
            margin: 0 0 8px;
            color: #3A5754;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 33px;
            font-weight: 800;
            letter-spacing: .2px;
        }
        .gfg5-accent { height: 9px; background: #8FA68C; margin: 0 0 18px; }

        .gfg5-body { margin: 8px 0; text-align: justify; }
        .gfg5-cost { color: #B91C1C; font-weight: 700; }
        .gfg5-amount { font-weight: 700; }

        .gfg5-cols { display: flex; gap: 22px; align-items: flex-start; flex-wrap: wrap; margin: 14px 0; }
        .gfg5-cols__left, .gfg5-cols__right { flex: 1 1 320px; }

        .gfg5-table { border-collapse: separate; border-spacing: 1px; margin: 0 auto; }
        .gfg5-table th, .gfg5-table td {
            padding: 5px 14px; font-size: 13px; text-align: center; border: none;
        }
        .gfg5-table th { background: #B91C1C; color: #ffffff; font-weight: 700; }
        .gfg5-table td { background: #4B5563; color: #ffffff; }

        .gfg5-row { margin: 12px 0; display: flex; align-items: baseline; gap: 10px; }
        .gfg5-row > .gfg5-label { flex: 0 0 auto; }
        .gfg5-row > .gfg5-blank {
            flex: 1 1 auto;
            min-width: 130px;
            border-bottom: 1px solid #9aa6a3;
            text-align: right;
            padding: 0 6px;
            color: #1f3b38;
            font-weight: 700;
        }

        /* Pricing projection table (big table near the bottom of the section) */
        .gfg5-proj { width: 100%; border-collapse: collapse; margin: 18px 0 4px; font-size: 13px; }
        .gfg5-proj th, .gfg5-proj td { padding: 6px 10px; text-align: center; border: 1px solid #ffffff; }
        .gfg5-proj thead th { background: #3A5754; color: #ffffff; font-weight: 700; }
        .gfg5-proj thead th.gfg5-proj__ageband { background: #B91C1C; }
        .gfg5-proj tbody td { background: #A5BFA1; color: #2b2b2b; }
        .gfg5-proj tbody td.gfg5-proj__age { background: #B91C1C; color: #ffffff; font-weight: 700; }
        .gfg5-proj tfoot td { background: #4B5563; color: #ffffff; font-weight: 700; padding: 10px; }

        .gfg5-rate-note { text-align: center; font-size: 12px; font-weight: 700; margin: 4px 0 16px; }

        /* Total Basic &amp; Optional Life Insurance section */
        .gfg5-summary-h {
            margin: 18px 0 12px;
            color: #2b2b2b;
            font-family: 'PT Serif', Georgia, serif;
            font-weight: 400;
            font-size: 22px;
        }
        .gfg5-summary { display: flex; gap: 26px; align-items: flex-start; flex-wrap: wrap; }
        .gfg5-summary__left { flex: 1 1 320px; }
        .gfg5-summary__head { display: flex; gap: 10px; padding-left: 100px; margin-bottom: 6px; font-style: italic; color: #555; }
        .gfg5-summary__head > span { flex: 1 1 auto; text-align: center; }
        .gfg5-summary__row {
            display: flex; gap: 10px; align-items: baseline;
            margin: 8px 0; padding-left: 0;
        }
        .gfg5-summary__row > .gfg5-summary__label { flex: 0 0 100px; }
        .gfg5-summary__row > .gfg5-summary__cell {
            flex: 1 1 auto; border-bottom: 1px solid #9aa6a3;
            min-height: 18px; padding: 0 6px; text-align: center;
        }
        .gfg5-summary__cell--empty { border-bottom: 1px solid transparent; }

        /* Right column of the summary: holds the boxes + disclaimer */
        .gfg5-summary__right { flex: 1 1 320px; }
        /* Three colored boxes (FEGLI OPT B / ALTERNATIVE / SAVINGS) */
        .gfg5-boxes { display: flex; gap: 6px; }
        .gfg5-box {
            flex: 1 1 0;
            padding: 14px 10px;
            text-align: center;
            color: #ffffff;
            font-family: 'PT Serif', Georgia, serif;
        }
        .gfg5-box--fegli { background: #8FA68C; }
        .gfg5-box--alt   { background: #3A5754; }
        .gfg5-box--save  { background: #4B5563; }
        .gfg5-box__title { font-size: 13px; letter-spacing: .5px; margin: 0 0 10px; font-weight: 700; }
        .gfg5-box__years { font-size: 13px; margin: 6px 0 2px; }
        .gfg5-box__amount { font-weight: 700; margin: 2px 0 12px; min-height: 18px; border-bottom: 1px solid rgba(255,255,255,0.4); padding: 0 4px; }

        .gfg5-bottom-note {
            text-align: center; font-size: 12px; margin: 14px 0 0;
            background: #f6f1e9; padding: 10px;
        }

        @media (max-width: 700px) {
            .gfg5-cols, .gfg5-summary { flex-direction: column; }
            .gfg5-boxes { flex-wrap: wrap; }
        }
    </style>

    <div class="gfg5-doc">
        <div class="gfg5-sidebar"><span class="gfg5-pagenum">5</span></div>

        <div class="gfg5-main">

            <h1 class="gfg5-title">FEGLI- Option B</h1>
            <div class="gfg5-accent"></div>

            <p class="gfg5-body">
                Option B - Additional Optional Insurance - This benefit is calculated by
                taking your annual rate of pay and rounding it to the next $1,000 and
                using your multiplier (1-5) to determine your coverage amount. The factor
                chart below is based on each $1,000 of coverage. Group costs to the
                employee increase every five years after age 35.
            </p>

            <div class="gfg5-cols">
                <!-- Left: factor table -->
                <div class="gfg5-cols__left">
                    <table class="gfg5-table">
                        <thead>
                            <tr>
                                <th>Employee Age Band</th>
                                <th>Bi-Weekly Factor</th>
                                <th>Monthly Factor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Under 35</td><td>$0.02</td><td>$0.043</td></tr>
                            <tr><td>35-39</td><td>$0.02</td><td>$0.043</td></tr>
                            <tr><td>40-44</td><td>$0.03</td><td>$0.065</td></tr>
                            <tr><td>45-49</td><td>$0.06</td><td>$0.130</td></tr>
                            <tr><td>50-54</td><td>$0.10</td><td>$0.217</td></tr>
                            <tr><td>55-59</td><td>$0.18</td><td>$0.390</td></tr>
                            <tr><td>60-64</td><td>$0.40</td><td>$0.867</td></tr>
                            <tr><td>65-69</td><td>$0.48</td><td>$1.040</td></tr>
                            <tr><td>70-74</td><td>$0.86</td><td>$1.863</td></tr>
                            <tr><td>75-79</td><td>$1.80</td><td>$3.90</td></tr>
                            <tr><td>80+</td><td>$2.88</td><td>$6.240</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Right: calculation rows -->
                <div class="gfg5-cols__right">
                    <div class="gfg5-row">
                        <span class="gfg5-label">Annual Rate of Pay Rounded Up:</span>
                        <span class="gfg5-blank">
                            <apex:outputText value="{0, number, $#,##0.00}">
                                <apex:param value="{!annualRatePay}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-row">
                        <span class="gfg5-label">Your Multiplier:</span>
                        <span class="gfg5-blank">
                            <apex:outputText value="{0, number, #0}">
                                <apex:param value="{!multiplier}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-row">
                        <span class="gfg5-label">Option B Insurance Coverage:</span>
                        <span class="gfg5-blank">
                            <apex:outputText value="{0, number, $#,##0.00}">
                                <apex:param value="{!optionBCoverage}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-row">
                        <span class="gfg5-label">Bi-Weekly Cost:</span>
                        <span class="gfg5-blank">
                            <apex:outputText value="{0, number, $#,##0.00}">
                                <apex:param value="{!optionBBiWeeklyCost}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-row">
                        <span class="gfg5-label">Monthly Cost:</span>
                        <span class="gfg5-blank">
                            <apex:outputText value="{0, number, $#,##0.00}">
                                <apex:param value="{!optionBMonthlyCost}" />
                            </apex:outputText>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Future-cost projection table -->
            <table class="gfg5-proj">
                <thead>
                    <tr>
                        <th>Option B</th>
                        <th>$250,000 Coverage</th>
                        <th>$375,000 Coverage</th>
                        <th>$500,000 Coverage</th>
                        <th>$625,000 Coverage</th>
                    </tr>
                    <tr>
                        <th class="gfg5-proj__ageband">Age Band</th>
                        <th class="gfg5-proj__ageband"></th>
                        <th class="gfg5-proj__ageband"></th>
                        <th class="gfg5-proj__ageband"></th>
                        <th class="gfg5-proj__ageband"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="gfg5-proj__age">50-54</td><td>$3,250</td><td>$4,875</td><td>$6,500</td><td>$8,125</td></tr>
                    <tr><td class="gfg5-proj__age">55-59</td><td>$5,850</td><td>$8,775</td><td>$11,700</td><td>$14,625</td></tr>
                    <tr><td class="gfg5-proj__age">60-64</td><td>$13,300</td><td>$19,500</td><td>$26,000</td><td>$32,500</td></tr>
                    <tr><td class="gfg5-proj__age">65-69</td><td>$15,600</td><td>$23,400</td><td>$31,200</td><td>$39,000</td></tr>
                    <tr><td class="gfg5-proj__age">70-74</td><td>$27,950</td><td>$41,925</td><td>$55,900</td><td>$69,875</td></tr>
                    <tr><td class="gfg5-proj__age">75-79</td><td>$58,500</td><td>$87,750</td><td>$117,000</td><td>$146,250</td></tr>
                    <tr><td class="gfg5-proj__age">80 Plus</td><td>$18,720 per year</td><td>$28,080 per year</td><td>$37,440 per year</td><td>$46,800 per year</td></tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td>Total Cost From Age 50-80</td>
                        <td>$143,170</td>
                        <td>$214,305</td>
                        <td>$285,740</td>
                        <td>$357,175</td>
                    </tr>
                </tfoot>
            </table>
            <p class="gfg5-rate-note">**Rates are based on current FEGLI rates. Rates are subject to change.</p>

            <!-- Total Basic and Optional Life Insurance -->
            <h2 class="gfg5-summary-h">Total Basic &amp; Optional Life Insurance</h2>

            <div class="gfg5-summary">
                <div class="gfg5-summary__left">
                    <div class="gfg5-summary__head">
                        <span>Coverage</span>
                        <span>Bi-Weekly Cost</span>
                    </div>
                    <div class="gfg5-summary__row">
                        <span class="gfg5-summary__label">Basic Life:</span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!basicCoverage}" />
                            </apex:outputText>
                        </span>
                        <span class="gfg5-summary__cell">
                            <!-- USPS employees / unselected Basic show "$ --" instead of "$0.00" -->
                            <apex:outputPanel layout="none" rendered="{!basicBiWeeklyCost > 0}">$
                                <apex:outputText value="{0, number, #,##0.00}">
                                    <apex:param value="{!basicBiWeeklyCost}" />
                                </apex:outputText>
                            </apex:outputPanel>
                            <apex:outputPanel layout="none" rendered="{!basicBiWeeklyCost <= 0}">$ --</apex:outputPanel>
                        </span>
                    </div>
                    <div class="gfg5-summary__row">
                        <span class="gfg5-summary__label">OPT A:</span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!optionACoverage}" />
                            </apex:outputText>
                        </span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!optionABiWeeklyCost}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-summary__row">
                        <span class="gfg5-summary__label">OPT B:</span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!optionBCoverage}" />
                            </apex:outputText>
                        </span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!optionBBiWeeklyCost}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-summary__row">
                        <span class="gfg5-summary__label">OPT C:</span>
                        <!-- Coverage left empty (no value) but the underline stays visible
                             so the blank fill-in line sits on the same baseline as the
                             bi-weekly cost cell next to it. -->
                        <span class="gfg5-summary__cell">
                            <apex:outputPanel layout="none">$ --</apex:outputPanel>
                        </span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!optionCBiWeeklyCost}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-summary__row">
                        <span class="gfg5-summary__label">TOTAL:</span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!totalCoverage}" />
                            </apex:outputText>
                        </span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!totalBiWeeklyCost}" />
                            </apex:outputText>
                        </span>
                    </div>
                    <div class="gfg5-summary__row">
                        <span class="gfg5-summary__label">Monthly Cost</span>
                        <span class="gfg5-summary__cell">$
                            <apex:outputText value="{0, number, #,##0.00}">
                                <apex:param value="{!totalMonthlyCost}" />
                            </apex:outputText>
                        </span>
                    </div>
                </div>

                <!-- Right column: three colored projection boxes + disclaimer directly below -->
                <div class="gfg5-summary__right">
                    <div class="gfg5-boxes">
                        <div class="gfg5-box gfg5-box--fegli">
                            <p class="gfg5-box__title">FEGLI OPT. B</p>
                            <p class="gfg5-box__years">20 Years</p>
                            <div class="gfg5-box__amount">$</div>
                            <p class="gfg5-box__years">30 Years</p>
                            <div class="gfg5-box__amount">$</div>
                        </div>
                        <div class="gfg5-box gfg5-box--alt">
                            <p class="gfg5-box__title">ALTERNATIVE</p>
                            <p class="gfg5-box__years">&#160;</p>
                            <div class="gfg5-box__amount">$</div>
                            <p class="gfg5-box__years">&#160;</p>
                            <div class="gfg5-box__amount">$</div>
                        </div>
                        <div class="gfg5-box gfg5-box--save">
                            <p class="gfg5-box__title">SAVINGS</p>
                            <p class="gfg5-box__years">&#160;</p>
                            <div class="gfg5-box__amount">$</div>
                            <p class="gfg5-box__years">&#160;</p>
                            <div class="gfg5-box__amount">$</div>
                        </div>
                    </div>

                    <p class="gfg5-bottom-note">
                        Rates are subject to change and are not guaranteed upon approval.<br/>
                        FEGLI rates are based on current rates.
                    </p>
                </div>
            </div>

        </div>
    </div>
</apex:page>
