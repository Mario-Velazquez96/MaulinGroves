                                                    <apex:param value="{!(((Lead.High_3_Salary2__c * 0.011) * (Lead.Scenario2_Retirement_Age__c - ABS((FLOOR((Lead.Date_of_Birth__c -  Lead.Date_of_Hire__c ) / 365.25))))) / 12) - ((((Lead.High_3_Salary2__c * 0.011) * (Lead.Scenario2_Retirement_Age__c - ABS((FLOOR((Lead.Date_of_Birth__c -  Lead.Date_of_Hire__c ) / 365.25))))) / 12) * 0.50)}"/>
                                                    SM OLD ENDS -->
                                                        <!-- SM NEW STARTS -->
                                                        <apex:param value="{!(((Lead.High_3_Salary2__c * 0.011) * (scenario2XYOS)) / 12) - ((((Lead.High_3_Salary2__c * 0.011) * (scenario2XYOS)) / 12) * 0.50)}" />
                                                        <!-- SM NEW ENDS -->
                                                    </apex:outputText>
                                                    <apex:outputText value="{0, number, $###,###,##0.00}"
                                                        rendered="{!Lead.FERS__c == true && Lead.Expected_Retirement_Age__c != null && Lead.Expected_Retirement_Age__c = 61 && Lead.Scenario1_Primary__c == false && Lead.Scenario2_Primary__c == false && Lead.Opt_Out__c == false}">
                                                        <apex:param value="{!(((Lead.High_3_Salary__c * 0.01) * Lead.Years_of_Employment__c) / 12) - ((((Lead.High_3_Salary__c * 0.01) * Lead.Years_of_Employment__c) / 12) * 0.50)}" />
                                                    </apex:outputText>
                                                    <apex:outputText value="{0, number, $###,###,##0.00}"
                                                        rendered="{!Lead.FERS__c == true && Lead.Expected_Retirement_Age__c != null && Lead.Expected_Retirement_Age__c < 61 && Lead.Scenario1_Primary__c == false && Lead.Scenario2_Primary__c == false && Lead.Opt_Out__c == false}">
                                                        <apex:param value="{!(((Lead.High_3_Salary__c * 0.01) * Lead.Years_of_Employment__c) / 12) - ((((Lead.High_3_Salary__c * 0.01) * Lead.Years_of_Employment__c) / 12) * 0.50)}" />
                                                    </apex:outputText>
                                                    <apex:outputText value="{0, number, $###,###,##0.00}"
                                                        rendered="{!Lead.FERS__c == true && Lead.Expected_Retirement_Age__c != null && Lead.Expected_Retirement_Age__c > 61 && Lead.Years_of_Employment__c < 20 && Lead.Scenario1_Primary__c == false && Lead.Scenario2_Primary__c == false && Lead.Opt_Out__c == false}">
                                                        <apex:param value="{!(((Lead.High_3_Salary__c * 0.01) * Lead.Years_of_Employment__c) / 12) - ((((Lead.High_3_Salary__c * 0.01) * Lead.Years_of_Employment__c) / 12) * 0.50)}" />
                                                    </apex:outputText>
                                                    <apex:outputText value="{0, number, $###,###,##0.00}"
                                                        rendered="{!Lead.FERS__c == true && Lead.Expected_Retirement_Age__c != null && Lead.Expected_Retirement_Age__c > 61 && Lead.Years_of_Employment__c > 19 && Lead.Scenario1_Primary__c == false && Lead.Scenario2_Primary__c == false && Lead.Opt_Out__c == false}">
                                                        <apex:param value="{!(((Lead.High_3_Salary__c * 0.011) * Lead.Years_of_Employment__c) / 12) - ((((Lead.High_3_Salary__c * 0.011) * Lead.Years_of_Employment__c) / 12) * 0.50)}" />
                                                    </apex:outputText>
                                                    <apex:outputText value="{0, number, $###,###,##0.00}" rendered="{!Lead.FERS__c== false && Lead.Special_Group_Member__c==true}">
                                                    <apex:param value="{!(((((Lead.High_3_Salary__c * 0.017) * 20) + ((Lead.High_3_Salary__c * 0.01) * Lead.Remaining_Years__c)) / 12) * 0.50)}"/>
                                                             </apex:outputText>
                                                </b></u>
                                        </p>
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </apex:outputPanel>
