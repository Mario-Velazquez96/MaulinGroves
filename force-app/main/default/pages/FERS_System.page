                                    <b>
                                        1.
                                        <span style="padding-left: 10pt;">
                                            The Basic Benefit Plan – FERS Retirement Annuity
                                        </span>
                                    </b>
                                </p>
                            </td>
                            <td colspan="4">
                                <p class="s38"
                                    style="padding-right: 72pt;text-align: left;font-size: 12pt;color: #2E5395;">
                                    <b>
                                        2.
                                        <span style="padding-left: 10pt;">
                                            Social Security
                                        </span>
                                    </b>
                                </p>
                            </td>
                            <td colspan="4">
                                <p class="s38" style="text-align: left;font-size: 12pt;color: #2E5395;">
                                    <b>
                                        3.
                                        <span style="padding-left: 10pt;">
                                            Thrift Savings Plan
                                        </span>
                                    </b>
