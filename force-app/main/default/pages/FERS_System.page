    <a name="FERS_Special_Supplement"></a>
    <!--FERS_Special_Supplement-->
    <center>
        <apex:form id="FERS_Special_Supp" style="width: 85%">
            <apex:pageBlock id="page14" mode="edit">
                <apex:actionRegion >
                    <apex:outputPanel id="specialsupp"
                        rendered="{!(IF(Lead.Special_Group_Member__c == true, IF(Lead.Expected_Retirement_Age__c < 62,true, false), (IF(Lead.FERS__c == true, (IF(Lead.Scenario1_Primary__c == true && Lead.Scenario1_Retirement_Age__c < 62,true,false) || IF(Lead.Scenario2_Primary__c == true && Lead.Scenario2_Retirement_Age__c < 62,true,false)), IF(Lead.Special_Group_Member__c == false && Lead.FERS__c == false && Lead.Expected_Retirement_Age__c < 62, true, false)))))}">
                        <table style="width: 85%" align="center" cellspacing="0">
                            <tbody>
                                <tr style="height:26pt">
                                    <td colspan="100%">
                                        <p
                                            style="padding-top: 0pt;padding-left: 0pt;text-indent: 0pt;text-align: left;" />
                                        <apex:image url="{!$Resource.Pg14FedbookTop}" width="100%" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <style>
                            table,
                            td,
                            p,
                            span {
                                border-collapse: collapse;
                            }

                            td {
                                padding-top: 4px;
                                padding-bottom: 2px;
                                padding-left: 5px;
                                padding-right: 5px;
                            }

                            p {
                                padding-top: 4px;
                            }

                            span {
                                padding-top: 4px;
                            }
                        </style>

                        <!-- Calculate Button hide<center> <apex:commandButton onclick="window.location.top.reload();" action="{!RerenderPage}" value="Calculate" style="color: green;"/>  </center>-->
                        <p style="padding-top: 3pt;"></p>
                        <!-- <apex:outputPanel rendered="{!((IF(Lead.Scenario1_Primary__c == true && Lead.Scenario1_Retirement_Age__c < 62, true,false) || IF(Lead.Scenario2_Primary__c == true && Lead.Scenario2_Retirement_Age__c < 62,true,false) || IF(Lead.Scenario1_Primary__c == false && Lead.Scenario2_Primary__c == false && Lead.Expected_Retirement_Age__c < 62,true,false)))}" layout="none"> -->
                           <apex:outputPanel rendered="{!(IF(Lead.Special_Group_Member__c == true, IF(Lead.Expected_Retirement_Age__c < 62,true, false), (IF(Lead.FERS__c == true, (IF(Lead.Scenario1_Primary__c == true && Lead.Scenario1_Retirement_Age__c < 62,true,false) || IF(Lead.Scenario2_Primary__c == true && Lead.Scenario2_Retirement_Age__c < 62,true,false)), IF(Lead.Special_Group_Member__c == false && Lead.FERS__c == false && Lead.Expected_Retirement_Age__c < 62, true, false)))))}" layout="none">
                            <table style="width: 80%" align="center" cellspacing="0">
                                <tbody>
                                    <tr>
                                        <td style="width:485pt">
                                            <p class="s38" style="padding-top: 4pt;font-size: 11pt;text-align: justify;">
                                                Also known as the <a name="Bookmark12">Special Retirement Supplement</a> or
                                                SRS. It is designed to help bridge the income gap for certain FERS employees
                                                who retire before age 62. It will supplement your missing Social Security
                                                income, until you reach age 62 and then stop. Since the SRS is not paid by
                                                Social Security, you do not have to start receiving benefits from Social
                                                Security at age 62. You may delay taking these benefits to help increase
                                                your future Social Security annuity.</p>
                                            <p class="s38" style="padding-top: 8pt;font-size: 11pt;text-align: justify;">To
                                                be eligible, you must have a normal immediate retirement, not an early
                                                retirement (MRA+10).
                                                <span style="color: red;">
                                                    This means you must have
                                                    <u>
                                                        <b>30 years</b>
                                                    </u>
                                                    of creditable service and meet your
                                                    <u>
                                                        <b> MRA</b>
                                                    </u>
                                                    or, you can have
                                                    <u>
                                                        <b>20 years</b>
                                                    </u>
                                                    of creditable service and be
                                                    <u>
                                                        <b>age 60</b>
                                                    </u>.
                                                </span>
                                                <span style="color: black;">
                                                    To recap:
                                                </span>
                                            </p>
                                            <p class="s38" style="padding-top: 8pt;font-size: 11pt;text-align: center;">
                                                <b>You may be eligible if:</b></p>
                                            <p class="s38" style="padding-top: 5ptfont-size: 11pt;text-align: center;">You
                                                retire voluntarily <b>|</b> You are on an Immediate Annuity <b>|</b> Annuity
                                                not reduced for age</p>
                                            <p class="s38" style="padding-top: 8pt;font-size: 11pt;text-align: center;">
                                                <b>You may still be eligible if you:</b></p>
                                            <p class="s38" style="padding-top: 5pt;font-size: 11pt;text-align: center;">You
                                                retire involuntarily before attaining MRA <b>|</b> Due to a major
                                                reorganization <b>|</b> A reduction in force</p>
                                            <p class="s38" style="padding-top: 8pt;font-size: 11pt;text-align: center;">
                                                <b>You are <u>not</u> eligible if:</b></p>
                                            <p class="s38" style="padding-top: 5pt;font-size: 11pt;text-align: center;">You
                                                receive a Deferred Annuity Benefit <b>|</b> You receive a Disability benefit
                                                <b>|</b> You receive an Immediate MRA +10 Annuity Benefit
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:485pt">
                                            <p class="s38"
                                                style="padding-top: 8pt;font-size: 12pt;text-align: center;color: #2E5395;">
                                                <u>
                                                    <b>
                                                        Eligibility
                                                    </b>
                                                </u>
                                            </p>
                                            <p class="s38"
                                                style="padding-top: 5pt;color: red;text-align: center; font-size: 11pt;">
                                                •
                                                <span style="color: black; padding-left: 5pt;">
                                                    You must be a FERS employee
                                                </span>
                                            </p>
                                            <p class="s38"
                                                style="padding-top: 5pt;color: red;text-align: center; font-size: 11pt;">
                                                •
                                                <span style="color: black; padding-left: 5pt;">
                                                    You must retire on a full immediate retirement
                                                </span>
                                            </p>
                                            <p class="s38"
                                                style="padding-top: 5pt;color: red;text-align: center; font-size: 11pt;">
                                                •
                                                <span style="color: black; padding-left: 5pt;">
                                                    You must have 25 years of creditable service under Special Provisions
                                                    and be any age, or have 20 years of creditable service under Special
                                                    Provisions and be at least 50 years old
                                                </span>
                                            </p>
                                            <p class="s38"
                                                style="font-size: 10pt;padding-top: 8pt;text-align: center;color: red;">
                                                <i>Note: If you do not have enough years of creditable service under Special
                                                    Provisions, you may qualify for the FERS Supplement. If you retire under
                                                    the regular FERS immediate retirement rules, see above.</i>
                                            </p>
                                            <p class="s38"
                                                style="padding-top: 8pt;font-size: 12pt;text-align: center;color: #2E5395;">
                                                <u>
                                                    <b>
                                                        How the Earnings Test affects your SRS
                                                    </b>
                                                </u>
                                            </p>
                                            <p class="s38" style="padding-top: 8pt;font-size: 11pt;text-align: justify;">
                                                Although the SRS is not paid by Social Security, it is subject to the
                                                Earnings Test. This is the amount of income allowed before Social Security
                                                benefits would be affected. This also applies to the SRS. For
                                                <b><u>2024</u></b>, the exempt amount you can earn before withholdings is
                                                <b><u>$22,320</u></b> annually or <b><u>$1,860</u></b> monthly. After
                                                reaching the exempt amount, your SRS is reduced by $1.00 for every $2.00
                                                over. For current exempt amounts please visit: <a
                                                    href="http://www.ssa.gov/OACT/COLA/rtea.html"
                                                    style="color: blue;">https://www.ssa.gov/OACT/COLA/rtea.html</a>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:485pt">
                                            <p class="s38" style="font-size: 11pt;text-align: center;">
                                                <b>Example:</b> Your SRS is <u>$1,470</u> monthly and you earned an
                                                additional <u>$1,610</u> that month.</p>
                                            <p class="s38"
                                                style="padding-top: 8pt;font-size: 11pt;text-align: center;color: red;">
                                                •
                                                <span style="color: black; padding-left: 5pt;">
                                                    <b><u>$1,610</u></b> (earned) minus (-) <b><u>$1,580</u></b> (exempt
                                                    amount)
                                                    =
                                                </span>
                                                <span class="s38" style="font-size: 11pt;color: red;">
                                                    <b>$30 over exempt amount</b>
                                                </span>
                                                <span style="color: black; padding-left: 5pt;">
                                                    / 2 =
                                                    <b><u>$15.00</u></b> deducted from SRS benefit
                                                </span>
                                            </p>
                                            <p class="s38" style="padding-top: 8pt;font-size: 11pt;text-align: center;">
                                                The Earnings Test does not apply to Special Groups
                                                <u>
                                                    <b>
                                                        until
                                                    </b>
                                                </u> they reach their regular <b><u>FERS Minimum Retirement Age
                                                        (MRA)</u></b>, at which point the Earnings Test will apply.
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:485pt">
                                            <p class="s38"
                                                style="padding-top: 8pt;font-size: 12pt;text-align: center;color: #2E5395;">
                                                <u>
                                                    <b>
                                                        Calculating Your Special Supplement
                                                    </b>
                                                </u>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:485pt">
                                            <p class="s20"
                                                style="padding-top: 4pt;padding-left: 3pt;font-size: 11pt;padding-right: 4pt;text-indent: 0pt;text-align: center;color: #2E5395;">
                                                <b>Years of Service:</b>
                                                <span style="padding-left: 5pt;">
                                                    <apex:inputField value="{!Lead.YOS_Special_Supplement__c}"
                                                        style="height: 17px; width:40px;background-color: #00daff0f;border: none;border: 1px solid #ccc;">
                                                        <apex:actionSupport action="{!save}" event="onchange"
                                                            reRender="page14,primary1,primary2,page11,page12,financial,specialsupp,pension,pension_spouse,OBEF,navBar,Snapshot,FERS_Calculations,page10,FERS_Annuity,page19" />
                                                    </apex:inputField>
                                                </span>
                                                <span style="color: black;">
                                                    / 40 =
                                                </span>
                                                <u>
                                                    <b>
                                                        <apex:outputText value="{0, number, ###,###,##0.0}">
                                                            <apex:param value="{!(Lead.YOS_Special_Supplement__c / 40) * 100}" />
                                                        </apex:outputText>%
                                                    </b>
                                                </u>

                                            </p>
                                            <p style="text-indent: 0pt;text-align: left;">
                                            </p>
                                            <p class="s20"
                                                style="padding-left: 3pt;font-size: 11pt;padding-right: 4pt;text-indent: 0pt;line-height: 13pt;text-align: center;">
                                                <b><a name="Bookmark13" style="color: #2E5395;">Social Security</a> : $</b>
                                                <apex:inputField value="{!Lead.Predicted_Social_Security__c}"
                                                    style="height: 17px; width:60px;background-color: #00daff0f;border: none;border: 1px solid #ccc;">
                                                    <apex:actionSupport action="{!save}" event="onchange"
                                                        reRender="page14,primary1,primary2,page11,page12,financial,specialsupp,pension,pension_spouse,OBEF,navBar,Snapshot,FERS_Calculations,page10,FERS_Annuity,page19" />
                                                </apex:inputField>
                                                x
                                                <apex:outputText value="{0, number, ###,###,##0.0}">
                                                    <apex:param value="{!(Lead.YOS_Special_Supplement__c / 40) * 100}" />
                                                </apex:outputText>%
                                                =
                                                <span style="color: red;">
                                                    <u>
                                                        <b>
                                                            <apex:outputText value="{0, number, $###,###,##0.00}">
                                                                <apex:param value="{!Lead.Predicted_Social_Security__c * (Lead.YOS_Special_Supplement__c / 40)}" />
                                                            </apex:outputText>
                                                        </b>
                                                    </u>
                                                </span>
                                                <span style="font-size: 10pt; color: red;">
                                                    <br />• Your FERS Special Supplement •
                                                </span>
                                            </p>
                                            <p class="s38"
                                                style="padding-top: 8pt;font-size: 10pt;text-align: center;color: red;">
                                                <i>Note: It is possible that your SRS could reduce to $0.00. If you receive
                                                    SRS, you must report your earnings to OPM.</i>
                                            </p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </apex:outputPanel>
                        <table style="width: 85%" align="center" cellspacing="0">
                            <tbody>
                                <tr style="height:26pt">
                                    <td colspan="100%">
                                        <center>
                                            <p
                                                style="margin-left:5pt;margin-right:5pt;padding-top:0pt;text-align: left;" />
                                            <apex:image url="{!$Resource.Pg14FedbookBottom}" width="100%" />
                                            <p style="text-indent: 0pt;text-align: left;"></p>
                                        </center>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </apex:outputPanel>
                </apex:actionRegion>
            </apex:pageBlock>
        </apex:form>
    </center>


