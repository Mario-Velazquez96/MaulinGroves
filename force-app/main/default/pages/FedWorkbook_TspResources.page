<apex:page id="tspResources12" standardController="Lead" extensions="FedWorkbook_TspResourcesExt"
    showHeader="false" sidebar="false" standardStylesheets="false"
    applyHtmlTag="false" applyBodyTag="false"
    docType="html-5.0" title="TSP - Thrift Savings Plan">
    <!--
      ============================================================
      FedWorkbook_TspResources  (Page 11)
      Three stacked sections:
        A. TSP - Thrift Savings Plan
        B. Resources
        C. Forms For Collecting Benefits (Military Time Recapture)
      Lead fields used:
        Regular_Contribution__c     (editable currency)
        Catchup_Contribution__c     (editable currency, catch-up for age 50+)
      Total Contribution computed in Apex: getTotalContribution()
      No render gate — always renders.
      Left sidebar.
      ============================================================
    -->

    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=PT+Serif:wght@400;700&amp;display=swap');

        /* ---- Document shell ---- */
        .gfg12-doc {
            position: relative;
            background: #ffffff;
            color: #2b2b2b;
            font-family: 'PT Serif', Georgia, 'Times New Roman', serif;
            font-size: 14px;
            line-height: 1.55;
            margin: 0 auto 24px;
            width: 850px;
            max-width: 100%;
            box-sizing: border-box;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        }

        /* Left sidebar */
        .gfg12-sidebar {
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 54px;
            background: #3A5754;
        }
        .gfg12-pagenum {
            position: absolute;
            bottom: 18px; left: 0;
            width: 54px;
            text-align: center;
            color: #ffffff;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 30px;
            font-weight: 800;
        }
        .gfg12-main {
            margin-left: 54px;
            padding: 26px 30px 36px;
        }

        /* ---- Title + accent bar ---- */
        .gfg12-title {
            margin: 0 0 8px;
            color: #3A5754;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 33px;
            font-weight: 800;
            letter-spacing: .2px;
            line-height: 1.1;
        }
        .gfg12-title--sub {
            font-size: 28px;
        }
        .gfg12-accent { height: 9px; background: #8FA68C; margin: 0 0 14px; }

        /* ---- Body text ---- */
        .gfg12-body {
            margin: 8px 0 10px;
            text-align: justify;
            font-size: 13px;
        }

        /* ---- Spacer between sections ---- */
        .gfg12-section-spacer { margin-top: 22px; }

        /* ---- Three-column TSP block ---- */
        .gfg12-three-col {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin: 12px 0;
        }
        .gfg12-col-left   { flex: 2.2; min-width: 0; }
        .gfg12-col-middle { flex: 1;   min-width: 0; text-align: center; }
        .gfg12-col-right  { flex: 2;   min-width: 0; }

        /* Column headings */
        .gfg12-col-heading {
            font-size: 13px;
            font-weight: 700;
            text-decoration: underline;
            margin: 0 0 8px;
        }
        .gfg12-col-heading--center { text-align: center; }

        /* Bullet list in left and right columns */
        .gfg12-bullets {
            list-style: disc;
            padding-left: 18px;
            margin: 4px 0;
        }
        .gfg12-bullets li {
            margin: 5px 0;
            font-size: 13px;
        }
        .gfg12-bullets--circle {
            list-style: circle;
            padding-left: 22px;
            margin: 2px 0;
        }
        .gfg12-bullets--circle li {
            font-size: 12px;
            margin: 3px 0;
        }

        /* Header row above the label+value bullet list (left column).
           Aligns "Contribution Limits" with the labels and "Current" with the values. */
        .gfg12-contrib-headers {
            display: flex;
            align-items: baseline;
            gap: 6px;
            margin: 0 0 4px;
            padding-left: 18px; /* match .gfg12-bullets padding so the left label aligns over the bullet text */
        }
        .gfg12-contrib-headers .gfg12-col-heading:first-child { flex: 1; }
        .gfg12-contrib-headers .gfg12-col-heading--center {
            display: inline-block;
            min-width: 90px;
            text-align: center;
        }

        /* Label-value row for contribution bullets */
        .gfg12-contrib-label {
            display: flex;
            align-items: baseline;
            gap: 6px;
            font-size: 13px;
        }
        .gfg12-contrib-name { flex: 1; }
        .gfg12-contrib-val {
            display: inline-block;
            min-width: 90px;
            border-bottom: 1px solid #2b2b2b;
            text-align: center;
            color: #1f3b38;
            padding: 0 4px;
            vertical-align: bottom;
        }
        /* Editable input styled to match underline blank */
        .gfg12-contrib-val input {
            border: 0;
            background: transparent;
            font: inherit;
            color: #1f3b38;
            width: 88px;
            text-align: center;
            padding: 0;
            outline: none;
            box-shadow: none;
        }
        .gfg12-contrib-val input:focus {
            border-bottom: 1px solid #3A5754;
        }

        /* Sub-label (e.g. "for employees over age 50") */
        .gfg12-sublabel {
            font-size: 10px;
            font-style: italic;
            margin: 1px 0 5px 18px;
            color: #555;
        }

        /* Footer note under contribution list */
        .gfg12-contrib-note {
            font-size: 10px;
            font-style: italic;
            margin-top: 8px;
            color: #444;
        }

        /* QR image centering */
        .gfg12-qr-wrap {
            display: flex;
            justify-content: center;
            margin-top: 6px;
        }

        /* TSP Options in Retirement block */
        .gfg12-options-block {
            margin-top: 14px;
            text-align: center;
        }
        .gfg12-options-heading {
            color: #B91C1C;
            font-size: 14px;
            font-weight: 700;
            text-decoration: underline;
            margin-bottom: 8px;
        }
        .gfg12-options-grid {
            display: inline-grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 40px;
            text-align: left;
        }
        .gfg12-option-item {
            color: #B91C1C;
            font-size: 13px;
            font-weight: 700;
            text-decoration: underline;
        }

        /* ---- Resources section ---- */
        .gfg12-link {
            color: #1f3b38;
            text-decoration: underline;
        }
        .gfg12-link-item {
            font-size: 13px;
            margin: 6px 0;
        }

        /* ---- Military Time Recapture table ---- */
        .gfg12-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 12px;
        }
        .gfg12-table-header td {
            background: #3A5754;
            color: #ffffff;
            font-size: 18px;
            font-family: 'Montserrat', Arial, sans-serif;
            font-weight: 700;
            text-align: center;
