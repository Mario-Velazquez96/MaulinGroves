     workbook pages/controllers so a manual YOS entry survives the Flow and
     is shared across FersCalc, FersSurvivor and FinancialSnapshot.
     Lists only the components changed for this feature. -->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
	<types>
		<members>FedWorkbook_FersCalc</members>
		<members>FedWorkbook_FinancialSnapshot</members>
		<members>FedWorkbook_PDF</members>
		<members>FedWorkbook_Preview</members>
		<name>ApexPage</name>
	</types>
	<types>
		<members>FedWorkbook_FersCalcExt</members>
		<members>FedWorkbook_FersCalcExtTest</members>
		<members>FedWorkbook_FersSurvivorExt</members>
		<members>FedWorkbook_FersSurvivorExtTest</members>
		<members>FedWorkbook_FinancialSnapshotExt</members>
		<members>FedWorkbook_FinancialSnapshotExtTest</members>
		<members>FedWorkbook_PDFExt</members>
		<members>FedWorkbook_PreviewExt</members>
		<members>FedWorkbook_PreviewExtTest</members>
		<name>ApexClass</name>
	</types>
	<types>
		<members>Lead.Scenario1_YOS_Manual__c</members>
		<members>Lead.Scenario2_YOS_Manual__c</members>
		<name>CustomField</name>
	</types>
	<version>67.0</version>
</Package>
